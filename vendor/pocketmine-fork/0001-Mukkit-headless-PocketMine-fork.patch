diff --git a/src/mukkit/polyfill/ext-stubs.php b/src/mukkit/polyfill/ext-stubs.php
new file mode 100644
index 000000000..26449e349
--- /dev/null
+++ b/src/mukkit/polyfill/ext-stubs.php
@@ -0,0 +1,28 @@
+<?php
+
+/*
+ * Mukkit: shims for extensions whose semantics the headless host does not depend on.
+ *
+ * Only symbols that can be reached *without* world storage, real networking or client
+ * authentication are shimmed here. Deliberately absent: leveldb, chunkutils2, encoding, morton,
+ * crypto - faking those would produce silently wrong world or packet data instead of a clear
+ * failure, and the headless host never calls them (see docs/pm-fork-plan.md).
+ *
+ * igbinary is included because AsyncTask payloads use it: PM's NonThreadSafeValue serialises with
+ * igbinary_serialize() and reads back with igbinary_unserialize(), and PHP's own serialize() is a
+ * faithful stand-in as long as both ends agree - which they do inside a single process.
+ */
+
+declare(strict_types=1);
+
+if(!function_exists("igbinary_serialize")){
+	function igbinary_serialize(mixed $value) : string|false{
+		return serialize($value);
+	}
+}
+
+if(!function_exists("igbinary_unserialize")){
+	function igbinary_unserialize(string $value) : mixed{
+		return unserialize($value);
+	}
+}
diff --git a/src/mukkit/polyfill/morton.php b/src/mukkit/polyfill/morton.php
new file mode 100644
index 000000000..09167e28b
--- /dev/null
+++ b/src/mukkit/polyfill/morton.php
@@ -0,0 +1,70 @@
+<?php
+
+/*
+ * Mukkit: userland ext-morton.
+ *
+ * Morton (Z-order) codes are how PocketMine packs chunk and block coordinates into single integer
+ * array keys. Item::getStateId() uses morton2d_encode(), which puts this on the boot path: recipe
+ * hashing calls it for every output stack.
+ *
+ * Bit layout matches the C extension: 2D interleaves 32 bits per axis into a 64-bit code, 3D
+ * interleaves 21 bits per axis (World::MORTON3D_BIT_SIZE). 2D decode sign-extends each 32-bit
+ * half, so chunkHash()/getXZ() round-trip negative chunk coordinates the way upstream expects.
+ */
+
+declare(strict_types=1);
+
+function morton2d_encode(int $x, int $y) : int{
+	$x &= 0xffffffff;
+	$y &= 0xffffffff;
+	$code = 0;
+	for($bit = 0; $bit < 32; $bit++){
+		$code |= (($x >> $bit) & 1) << ($bit * 2);
+		$code |= (($y >> $bit) & 1) << ($bit * 2 + 1);
+	}
+	return $code;
+}
+
+/**
+ * @return array{0: int, 1: int}
+ */
+function morton2d_decode(int $code) : array{
+	$x = 0;
+	$y = 0;
+	for($bit = 0; $bit < 32; $bit++){
+		$x |= (($code >> ($bit * 2)) & 1) << $bit;
+		$y |= (($code >> ($bit * 2 + 1)) & 1) << $bit;
+	}
+	//sign-extend from 32 bits: PM stores negative chunk coordinates in these halves
+	$x = $x >= 0x80000000 ? $x - 0x100000000 : $x;
+	$y = $y >= 0x80000000 ? $y - 0x100000000 : $y;
+	return [$x, $y];
+}
+
+function morton3d_encode(int $x, int $y, int $z) : int{
+	$x &= 0x1fffff;
+	$y &= 0x1fffff;
+	$z &= 0x1fffff;
+	$code = 0;
+	for($bit = 0; $bit < 21; $bit++){
+		$code |= (($x >> $bit) & 1) << ($bit * 3);
+		$code |= (($y >> $bit) & 1) << ($bit * 3 + 1);
+		$code |= (($z >> $bit) & 1) << ($bit * 3 + 2);
+	}
+	return $code;
+}
+
+/**
+ * @return array{0: int, 1: int, 2: int}
+ */
+function morton3d_decode(int $code) : array{
+	$x = 0;
+	$y = 0;
+	$z = 0;
+	for($bit = 0; $bit < 21; $bit++){
+		$x |= (($code >> ($bit * 3)) & 1) << $bit;
+		$y |= (($code >> ($bit * 3 + 1)) & 1) << $bit;
+		$z |= (($code >> ($bit * 3 + 2)) & 1) << $bit;
+	}
+	return [$x, $y, $z];
+}
diff --git a/src/mukkit/polyfill/thread.php b/src/mukkit/polyfill/thread.php
