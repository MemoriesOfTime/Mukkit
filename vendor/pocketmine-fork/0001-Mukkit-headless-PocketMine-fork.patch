@@ -0,0 +1,543 @@
+<?php
+
+declare(strict_types=1);
+
+namespace pocketmine\mukkit;
+
+use pocketmine\block\Block;
+use pocketmine\block\RuntimeBlockStateRegistry;
+use pocketmine\event\block\BlockBreakEvent;
+use pocketmine\event\block\BlockBurnEvent;
+use pocketmine\event\block\BlockFormEvent;
+use pocketmine\event\block\BlockGrowEvent;
+use pocketmine\event\block\BlockSpreadEvent;
+use pocketmine\event\block\LeavesDecayEvent;
+use pocketmine\event\HandlerListManager;
+use pocketmine\event\inventory\InventoryTransactionEvent;
+use pocketmine\event\player\PlayerDeathEvent;
+use pocketmine\event\player\PlayerDropItemEvent;
+use pocketmine\event\player\PlayerItemHeldEvent;
+use pocketmine\event\player\PlayerRespawnEvent;
+use pocketmine\event\player\PlayerToggleFlightEvent;
+use pocketmine\event\player\PlayerToggleGlideEvent;
+use pocketmine\event\player\PlayerToggleSneakEvent;
+use pocketmine\event\player\PlayerToggleSprintEvent;
+use pocketmine\event\player\PlayerToggleSwimEvent;
+use pocketmine\inventory\transaction\action\SlotChangeAction;
+use pocketmine\inventory\transaction\InventoryTransaction;
+use pocketmine\item\Item;
+use pocketmine\item\StringToItemParser;
+use pocketmine\item\VanillaItems;
+use pocketmine\world\Position;
+use pocketmine\world\World;
+
+/**
+ * Turns bridge event frames into real PocketMine events, and reports the verdict back.
+ *
+ * There are two tiers here, and the difference is the whole contract:
+ *
+ * - {@see CANCELLABLE} events are decisions. The adapter holds the Nukkit action, this class lets a
+ *   plugin veto it, and "allowed" is replayed by the adapter. Every entry has to be replayable
+ *   through public API after the fact, which is a stricter test than "an event exists".
+ * - {@see NOTIFY} events are news. PocketMine's event is not cancellable, and nothing the plugin
+ *   does can change what Nukkit already did; the frame is delivered so listeners can observe it.
+ *
+ * `demanded()` only walks the decision tier: interception is only worth a tick of latency when a
+ * plugin is waiting on the answer. News needs no demand - it is one frame per occurrence.
+ */
+final class BridgeEvents{
+
+	/**
+	 * Wire name => the PM event class that decides it.
+	 *
+	 * @var array<string, class-string>
+	 */
+	public const CANCELLABLE = [
+		"block.break" => BlockBreakEvent::class,
+		"player.drop" => PlayerDropItemEvent::class,
+		"player.item.held" => PlayerItemHeldEvent::class,
+		"player.toggle.sneak" => PlayerToggleSneakEvent::class,
+		"player.toggle.sprint" => PlayerToggleSprintEvent::class,
+		"player.toggle.fly" => PlayerToggleFlightEvent::class,
+		"player.toggle.glide" => PlayerToggleGlideEvent::class,
+		"player.toggle.swim" => PlayerToggleSwimEvent::class,
+		"block.grow" => BlockGrowEvent::class,
+		"block.spread" => BlockSpreadEvent::class,
+		"block.form" => BlockFormEvent::class,
+		"block.burn" => BlockBurnEvent::class,
+		"leaves.decay" => LeavesDecayEvent::class,
+		"inventory.transaction" => InventoryTransactionEvent::class,
+	];
+
+	/**
+	 * Wire name => the PM event class that only observes.
+	 *
+	 * @var array<string, class-string>
+	 */
+	public const NOTIFY = [
+		"player.respawn" => PlayerRespawnEvent::class,
+		"player.death" => PlayerDeathEvent::class,
+	];
+
+	/**
+	 * Events that name a world and a block instead of a player.
+	 *
+	 * A crop growing has no player behind it; the adapter sends the world and coordinates, and the
+	 * event is built against the mirrored world. Keeping the list here means the host does not
+	 * have to pattern-match wire names in two places.
+	 *
+	 * @var array<string, true>
+	 */
+	public const WORLD_EVENTS = [
+		"block.grow" => true,
+		"block.spread" => true,
+		"block.form" => true,
+		"block.burn" => true,
+		"leaves.decay" => true,
+	];
+
+	public function __construct(
+		private readonly BridgedPlayers $players
+	){}
+
+	/**
+	 * @return list<string>
+	 */
+	public static function demanded() : array{
+		$wanted = [];
+		foreach(self::CANCELLABLE as $name => $class){
+			if(count(HandlerListManager::global()->getHandlersFor($class)) > 0){
+				$wanted[] = $name;
+			}
+		}
+		return $wanted;
+	}
+
+	/**
+	 * Dispatches one decision and answers the adapter.
+	 *
+	 * @param array<string, mixed> $data
+	 *
+	 * @return array{allowed: bool}|null null = the frame could not be turned into an event
+	 */
+	public function dispatch(string $name, ?BridgedPlayer $player, array $data) : ?array{
+		$event = match($name){
+			"block.break" => $player === null ? null : $this->buildBlockBreak($player, $data),
+			"player.drop" => $player === null ? null : $this->buildPlayerDrop($player, $data),
+			"player.item.held" => $player === null ? null : $this->buildPlayerItemHeld($player, $data),
+			"player.toggle.sneak" => $player === null ? null : $this->buildToggle($player, $data, PlayerToggleSneakEvent::class),
+			"player.toggle.sprint" => $player === null ? null : $this->buildToggle($player, $data, PlayerToggleSprintEvent::class),
+			"player.toggle.fly" => $player === null ? null : $this->buildToggle($player, $data, PlayerToggleFlightEvent::class),
+			"player.toggle.glide" => $player === null ? null : $this->buildToggle($player, $data, PlayerToggleGlideEvent::class),
+			"player.toggle.swim" => $player === null ? null : $this->buildToggle($player, $data, PlayerToggleSwimEvent::class),
+			"block.grow" => $this->buildBlockGrow($data),
+			"block.spread" => $this->buildBlockSpread($data),
+			"block.form" => $this->buildBlockForm($data),
+			"block.burn" => $this->buildBlockBurn($data),
+			"leaves.decay" => $this->buildLeavesDecay($data),
+			"inventory.transaction" => $player === null ? null : $this->buildInventoryTransaction($player, $data),
+			default => null,
+		};
+		if($event === null){
+			return null;
+		}
+
+		$event->call();
+
+		//A container transaction is the one decision whose "allowed" side has to be applied
+		//here rather than on the adapter: the adapter cancelled Nukkit's transaction, so the
+		//items only move once this side has run the actions. Doing it after the event also means
+		//a plugin that rewrote a target item gets its version, not the client's prediction.
+		if($event instanceof InventoryTransactionEvent){
+			if($event->isCancelled()){
+				return ["allowed" => false];
+			}
+			$source = $event->getTransaction()->getSource();
+			foreach($event->getTransaction()->getActions() as $action){
+				if($action instanceof SlotChangeAction){
+					$action->execute($source);
+				}
+			}
+			return ["allowed" => true];
+		}
+
+		return ["allowed" => !$event->isCancelled()];
+	}
+
+	/**
+	 * Dispatches one observation. Returns false when the frame could not be built.
+	 *
+	 * @param array<string, mixed> $data
+	 */
+	public function notify(string $name, BridgedPlayer $player, array $data) : bool{
+		$event = match($name){
+			"player.respawn" => $this->buildPlayerRespawn($player, $data),
+			"player.death" => $this->buildPlayerDeath($player, $data),
+			default => null,
+		};
+		if($event === null){
+			return false;
+		}
+		$event->call();
+		return true;
+	}
+
+	/**
+	 * @param array<string, mixed> $data
+	 */
+	private function buildPlayerRespawn(BridgedPlayer $player, array $data) : ?PlayerRespawnEvent{
+		$world = $this->world($data);
+		if($world === null || !isset($data["x"], $data["y"], $data["z"])){
+			return null;
+		}
+		$position = new Position(
+			(float) $data["x"],
+			(float) $data["y"],
+			(float) $data["z"],
+			$world,
+			(float) ($data["yaw"] ?? 0.0),
+			(float) ($data["pitch"] ?? 0.0)
+		);
+		return new PlayerRespawnEvent($player, $position);
+	}
+
+	/**
+	 * A death that already happened on the Nukkit side.
+	 *
+	 * PocketMine 5's `PlayerDeathEvent` is not cancellable (`EntityDeathEvent` is not), so this is
+	 * honest news rather than a veto: plugins can change the message, the drops they see, and
+	 * `keepInventory` flags, but Nukkit has already run its own death tail. A bridge that
+	 * pretended otherwise would silently disagree with the world the player is standing in.
+	 *
+	 * @param array<string, mixed> $data
+	 */
+	private function buildPlayerDeath(BridgedPlayer $player, array $data) : ?PlayerDeathEvent{
+		$drops = [];
+		foreach(is_array($data["drops"] ?? null) ? $data["drops"] : [] as $tuple){
+			$item = self::itemFromTuple($tuple);
+			if($item !== null && !$item->isNull()){
+				$drops[] = $item;
+			}
+		}
+		$xp = is_int($data["xp"] ?? null) ? $data["xp"] : 0;
+		$message = $data["message"] ?? null;
+		return new PlayerDeathEvent(
+			$player,
+			$drops,
+			$xp,
+			is_string($message) && $message !== "" ? $message : null
+		);
+	}
+
+	/**
+	 * A client moving items in a container the bridge opened.
+	 *
+	 * The adapter cancels Nukkit's transaction before it executes, so the only thing that has
+	 * happened by the time this is built is that the client predicted the move and got its
+	 * correction. If the event is allowed, `dispatch()` executes the (possibly plugin-rewritten)
+	 * actions on this side; the adapter replays nothing and waits for the resulting content.
+	 *
+	 * @param array<string, mixed> $data
+	 */
+	private function buildInventoryTransaction(BridgedPlayer $player, array $data) : ?InventoryTransactionEvent{
+		$windowId = $data["window"] ?? null;
+		if(!is_int($windowId) || $windowId <= 0){
+			return null;
+		}
+		$window = $player->getCurrentWindow();
+		if($window === null){
+			return null;
+		}
+		$manager = $player->getNetworkSession()->getInvManager();
+		if($manager === null || $manager->getWindowId($window) !== $windowId){
+			//A transaction for a window that is no longer the current one (the plugin closed it
+			//between the client's click and this frame) has nowhere to land.
+			return null;
+		}
+
+		$actions = [];
+		foreach(is_array($data["actions"] ?? null) ? $data["actions"] : [] as $entry){
+			if(!is_array($entry)){
+				return null;
+			}
+			$kind = $entry["inv"] ?? null;
+			$slot = $entry["slot"] ?? null;
+			if(!is_int($slot) || $slot < 0){
+				return null;
+			}
+			if($kind === "window"){
+				$inventory = $window;
+				$index = $slot;
+			}elseif($kind === "player"){
+				$inventory = BridgePlayerInventory::inventoryAt($player, $slot);
+				$index = BridgePlayerInventory::indexAt($slot);
+			}else{
+				return null;
+			}
+			$from = self::itemFromTuple($entry["from"] ?? null);
+			$to = self::itemFromTuple($entry["to"] ?? null);
+			if($from === null || $to === null){
+				return null;
+			}
+			$actions[] = new SlotChangeAction($inventory, $index, $from, $to);
+		}
+		if($actions === []){
+			return null;
+		}
+		return new InventoryTransactionEvent(new InventoryTransaction($player, $actions));
+	}
+
+	/**
+	 * @param mixed $tuple `[id, count, meta]` plus optional base64 NBT
+	 */
+	private static function itemFromTuple(mixed $tuple) : ?Item{
+		if(!is_array($tuple) || count($tuple) < 3){
+			return null;
+		}
+		[$item, ] = BridgePlayerInventory::parseItem(
+			(string) ($tuple[0] ?? ""),
+			(int) ($tuple[1] ?? 0),
+			(int) ($tuple[2] ?? 0),
+			isset($tuple[3]) ? (string) $tuple[3] : null
+		);
+		return $item;
+	}
+
+	/**
+	 * A hotbar switch. The item travels in the inventory dialect so the plugin sees the stack the
+	 * player is about to hold, not just a slot number.
+	 *
+	 * @param array<string, mixed> $data
+	 */
+	private function buildPlayerItemHeld(BridgedPlayer $player, array $data) : ?PlayerItemHeldEvent{
+		$slot = $data["slot"] ?? null;
+		if(!is_int($slot) || $slot < 0 || $slot > 8){
+			return null;
+		}
+		$tuple = $data["item"] ?? null;
+		$item = VanillaItems::AIR();
+		if(is_array($tuple) && count($tuple) >= 3){
+			[$parsed, ] = BridgePlayerInventory::parseItem(
+				(string) ($tuple[0] ?? ""),
+				(int) ($tuple[1] ?? 0),
+				(int) ($tuple[2] ?? 0),
+				isset($tuple[3]) ? (string) $tuple[3] : null
+			);
+			//A frame naming an item this build does not have is not a reason to deny a switch: the
+			//slot is still the slot. Air is visible in the event, which is the honest answer.
+			$item = $parsed ?? VanillaItems::AIR();
+		}
+		return new PlayerItemHeldEvent($player, $item, $slot);
+	}
+
+	/**
+	 * @param array<string, mixed> $data
+	 * @param class-string<PlayerToggleSneakEvent|PlayerToggleSprintEvent|PlayerToggleFlightEvent|PlayerToggleGlideEvent|PlayerToggleSwimEvent> $class
+	 */
+	private function buildToggle(BridgedPlayer $player, array $data, string $class) : ?\pocketmine\event\Event{
+		$state = $data["state"] ?? null;
+		if(!is_bool($state)){
+			return null;
+		}
+		//PocketMine's sneak event distinguishes "the state is now sneaking" from "the key is held";
+		//Nukkit only knows the former, so the two travel together rather than one being invented.
+		if($class === PlayerToggleSneakEvent::class){
+			return new PlayerToggleSneakEvent($player, $state, $state);
+		}
+		return new $class($player, $state);
+	}
+
+	/**
+	 * @param array<string, mixed> $data
+	 */
+	private function buildBlockGrow(array $data) : ?BlockGrowEvent{
+		$block = $this->blockFrom($data);
+		$newState = $this->blockFrom($data, "new");
+		if($block === null || $newState === null){
+			return null;
+		}
+		return new BlockGrowEvent($block, $newState);
+	}
+
+	/**
+	 * @param array<string, mixed> $data
+	 */
+	private function buildBlockSpread(array $data) : ?BlockSpreadEvent{
+		$block = $this->blockFrom($data);
+		$newState = $this->blockFrom($data, "new");
+		$source = $this->blockFrom($data, "source");
+		if($block === null || $newState === null || $source === null){
+			return null;
+		}
+		return new BlockSpreadEvent($block, $source, $newState);
+	}
+
+	/**
+	 * @param array<string, mixed> $data
+	 */
+	private function buildBlockForm(array $data) : ?BlockFormEvent{
+		$block = $this->blockFrom($data);
+		$newState = $this->blockFrom($data, "new");
+		if($block === null || $newState === null){
+			return null;
+		}
+		//Nukkit does not say what caused the form (soul sand, magma); the block itself is the only
+		//honest answer, and plugins read it as "where", which is right.
+		return new BlockFormEvent($block, $newState, $block);
+	}
+
+	/**
+	 * @param array<string, mixed> $data
+	 */
+	private function buildBlockBurn(array $data) : ?BlockBurnEvent{
+		$block = $this->blockFrom($data);
+		//Nukkit's event names no cause; the burned block is the only block we can point at.
+		return $block === null ? null : new BlockBurnEvent($block, $block);
+	}
+
+	/**
+	 * @param array<string, mixed> $data
+	 */
+	private function buildLeavesDecay(array $data) : ?LeavesDecayEvent{
+		$block = $this->blockFrom($data);
+		return $block === null ? null : new LeavesDecayEvent($block);
+	}
+
+	/**
+	 * Builds a block from the frame's world + coordinates + legacy id/meta.
+	 *
+	 * The state id is PocketMine's own numbering and is produced here, never sent: the wire uses the
+	 * legacy id/meta dialect both sides share (`BridgeBlocks`), the same one block updates use.
+	 *
+	 * @param array<string, mixed> $data
+	 * @param string $prefix "" for the block, "new" for the state it becomes, "source" for a spread
+	 */
+	private function blockFrom(array $data, string $prefix = "") : ?Block{
+		$world = $this->world($data);
+		if($world === null){
+			return null;
+		}
+		if($prefix === "source"){
+			//A spread source sits somewhere else, so it travels as its own little map.
+			$source = $data["source"] ?? null;
+			if(!is_array($source)){
+				return null;
+			}
+			return $this->blockAt(
+				$world,
+				$source["x"] ?? null,
+				$source["y"] ?? null,
+				$source["z"] ?? null,
+				$source["id"] ?? null,
+				$source["meta"] ?? 0
+			);
+		}
+		$new = $prefix === "new";
+		return $this->blockAt(
+			$world,
+			$data["x"] ?? null,
+			$data["y"] ?? null,
+			$data["z"] ?? null,
+			$new ? ($data["newId"] ?? null) : ($data["id"] ?? null),
+			$new ? ($data["newMeta"] ?? 0) : ($data["meta"] ?? 0)
+		);
+	}
+
+	private function blockAt(World $world, mixed $x, mixed $y, mixed $z, mixed $id, mixed $meta) : ?Block{
+		if(!is_int($x) || !is_int($y) || !is_int($z) || !is_int($id) || !is_int($meta)){
+			return null;
+		}
+		$stateId = BridgeBlocks::stateIdFromIdMeta($id, $meta);
+		if($stateId === null){
+			return null;
+		}
+		$block = RuntimeBlockStateRegistry::getInstance()->fromStateId($stateId);
+		$block->position($world, $x, $y, $z);
+		return $block;
+	}
+
+	/**
+	 * @param array<string, mixed> $data
+	 */
+	private function world(array $data) : ?World{
+		$name = $data["world"] ?? null;
+		if(!is_string($name) || $name === ""){
+			return null;
+		}
+		//`worldIfExists()` rather than `world()`: a block event for a world the host never mirrored
+		//would otherwise create an empty world just to hold an event about a block that is not in
+		//it. Not creating it is the fail-closed answer.
+		return $this->players->worldIfExists($name);
+	}
+
+	/**
+	 * A stack the player tried to throw out of the window.
+	 *
+	 * The item travels in the inventory dialect (`[id, count, damage, nbt?]`) rather than the flat
+	 * pair `block.break` uses, because a renamed or enchanted stack has to arrive here intact: the
+	 * plugin decides on the real item, and the adapter replays exactly what it handed over.
+	 *
+	 * @param array<string, mixed> $data
+	 */
+	private function buildPlayerDrop(BridgedPlayer $player, array $data) : ?PlayerDropItemEvent{
+		$tuple = $data["item"] ?? null;
+		if(!is_array($tuple) || count($tuple) < 3){
+			return null;
+		}
+		[$item, ] = BridgePlayerInventory::parseItem(
+			(string) ($tuple[0] ?? ""),
+			(int) ($tuple[1] ?? 0),
+			(int) ($tuple[2] ?? 0),
+			isset($tuple[3]) ? (string) $tuple[3] : null
+		);
+		//A frame naming an item this build does not have, or naming air, cannot be turned into a
+		//drop. Returning null answers "deny": the player keeps the stack, which is the recoverable
+		//failure - a phantom item would not be.
+		if($item === null || $item->isNull()){
+			return null;
+		}
+		return new PlayerDropItemEvent($player, $item);
+	}
+
+	/**
+	 * @param array<string, mixed> $data
+	 */
+	private function buildBlockBreak(BridgedPlayer $player, array $data) : ?BlockBreakEvent{
+		if(!isset($data["x"], $data["y"], $data["z"])){
+			return null;
+		}
+		//The block comes out of the mirror, so it is the real block type as long as the chunk is
+		//mirrored. Outside the mirrored radius this is air, which is a wrong answer to
+		//`getBlock()->getTypeId()` but a right answer to `getPosition()` - the part protection
+		//plugins actually use.
+		$block = $player->getWorld()->getBlockAt((int) $data["x"], (int) $data["y"], (int) $data["z"]);
+		return new BlockBreakEvent(
+			$player,
+			$block,
+			self::itemFrom($data["item"] ?? null, $data["itemCount"] ?? 1),
+			(bool) ($data["instaBreak"] ?? false)
+		);
+	}
+
+	/**
+	 * Builds a PM item from the namespaced id Nukkit reports.
+	 *
+	 * Items only ever travel as names here, never as numeric ids: PM's internal ids and Nukkit's
+	 * legacy ids are both build-specific, so a number would be a different item on the other side.
+	 */
+	private static function itemFrom(mixed $id, mixed $count) : Item{
+		if(!is_string($id) || $id === ""){
+			return VanillaItems::AIR();
+		}
+		$parser = StringToItemParser::getInstance();
+		$item = $parser->parse($id);
+		if($item === null && str_contains($id, ":")){
+			//Some aliases are registered without the namespace prefix.
+			$item = $parser->parse(substr($id, strpos($id, ":") + 1));
+		}
+		if($item === null){
+			return VanillaItems::AIR();
+		}
+		return $item->setCount(max(1, (int) $count));
+	}
+}
diff --git a/src/mukkit/BridgeOps.php b/src/mukkit/BridgeOps.php
new file mode 100644
index 000000000..35ad0bb93
--- /dev/null
+++ b/src/mukkit/BridgeOps.php
@@ -0,0 +1,69 @@
+<?php
+
+declare(strict_types=1);
+
+namespace pocketmine\mukkit;
+
+use pocketmine\permission\DefaultPermissions;
+use pocketmine\player\Player;
+use pocketmine\Server;
+
+/**
+ * Operator status, kept the same on both sides of the bridge.
+ *
+ * PocketMine 5 has no `Player::isOp()`: operator is a root permission
+ * (`pocketmine.group.operator`) that grants `pocketmine.group.user` and every permission a
+ * plugin declared with `default: op` (see `PluginManager`, which attaches those nodes to the
+ * operator root when a plugin loads). That is the whole reason op matters here - a plugin's
+ * `/setmoney` is allowed exactly when its node hangs off the operator root and the player holds
+ * it, so an op player who arrives from Nukkit has to become an op player in PocketMine or every
+ * administrative command silently refuses.
+ *
+ * Nukkit owns the answer. Its `ops.txt` is the file the admin edits, and a player who is not in
+ * it is not an operator, no matter what PocketMine's own copy says. The reverse direction exists
+ * as well, because a plugin calling `Server::addOp()` on an online player would otherwise watch
+ * the next poll quietly undo it.
+ *
+ * Only the operator bit travels. Arbitrary permission nodes do not, and cannot: PocketMine's
+ * `setBasePermission()` throws for a name no plugin registered, and an attachment (the only
+ * other way to grant a node) is tied to a `Plugin` instance the bridge does not have. A Nukkit
+ * permission plugin's per-node grants therefore stay on the Nukkit side; nodes declared in a
+ * PocketMine plugin's own `plugin.yml` resolve from the mirrored operator bit, which is the case
+ * that actually breaks plugins.
+ */
+final class BridgeOps{
+
+	/**
+	 * What PocketMine itself would answer, including permissions granted by `default: op`.
+	 *
+	 * Reading the root permission rather than a boolean field is deliberate: it is the same
+	 * question `Permissible::hasPermission()` answers internally, so a plugin that grants or
+	 * denies the operator root through an attachment is reported the way it behaves.
+	 */
+	public static function isOperator(Player $player) : bool{
+		return $player->hasPermission(DefaultPermissions::ROOT_OPERATOR);
+	}
+
+	/**
+	 * Makes PocketMine agree with `$operator`, reporting instead of throwing when it cannot.
+	 *
+	 * `Server::addOp()`/`removeOp()` are the only public way to flip this, and they are also what
+	 * persists `ops.txt` - so PocketMine's own copy of the list tracks Nukkit's instead of
+	 * drifting from it across restarts.
+	 *
+	 * @return list<string> reasons the flag could not be applied
+	 */
+	public static function sync(Server $server, string $name, bool $operator) : array{
+		if($server->isOp($name) === $operator){
+			return [];
+		}
+		if($operator){
+			$server->addOp($name);
+		}else{
+			$server->removeOp($name);
+		}
+		//Both calls are void, so the only honest way to report failure is to look again. It
+		//cannot fail today; if upstream ever starts validating names, this is where it shows.
+		return $server->isOp($name) === $operator ? [] : ["operator flag for " . $name . " did not change"];
+	}
+}
diff --git a/src/mukkit/BridgePlayerInventory.php b/src/mukkit/BridgePlayerInventory.php
new file mode 100644
index 000000000..4e7b70c7e
--- /dev/null
+++ b/src/mukkit/BridgePlayerInventory.php
@@ -0,0 +1,362 @@
+<?php
+
+declare(strict_types=1);
+
+namespace pocketmine\mukkit;
+
+use pocketmine\inventory\Inventory;
+use pocketmine\item\Durable;
+use pocketmine\item\Item;
+use pocketmine\item\StringToItemParser;
+use pocketmine\item\VanillaItems;
+use pocketmine\nbt\TreeRoot;
+use pocketmine\network\mcpe\protocol\serializer\NetworkNbtSerializer;
+use pocketmine\player\Player;
+
+/**
+ * Two-way mirror of a player's inventory.
+ *
+ * Same shape as `BridgePlayerState`, and for the same reason: PocketMine's own inventory sync
+ * hangs off an `InventoryManager` that only the login flow constructs, so nothing a plugin does
+ * to `getInventory()` produces a packet this session could forward. Diffing the public API is
+ * both simpler and more complete than reproducing login.
+ *
+ * A slot is addressed in the bridge's own numbering, which is the same on both sides:
+ *
+ *   0-35   inventory (hotbar 0-8)
+ *   36-39  armour: helmet, chestplate, leggings, boots
+ *   40     offhand
+ *
+ * Items travel as `[slot, id, count, meta]` plus an optional base64 NBT string. `id` is the
+ * flattened namespaced id (`minecraft:red_wool`), which is the one dialect both runtimes name
+ * items in; numeric ids are build-specific on both sides and would name a different item on the
+ * other side. `meta` now only means durability damage, since colour and shape are part of the
+ * name. NBT is passed through as bytes: both sides use Bedrock's network little-endian encoding.
+ *
+ * Echo suppression is the same rule as the other mirrors: after applying what Nukkit sent, the
+ * shadow is re-read from the player, so the next diff finds nothing. Re-reading rather than
+ * trusting the request matters here too - an armour slot can reject an item, and a plugin can
+ * cancel the change event.
+ */
+final class BridgePlayerInventory
+{
+    public const SLOT_INVENTORY = 36;
+    public const SLOT_ARMOR_HEAD = 36;
+    public const SLOT_ARMOR_CHEST = 37;
+    public const SLOT_ARMOR_LEGS = 38;
+    public const SLOT_ARMOR_FEET = 39;
+    public const SLOT_OFFHAND = 40;
+    public const SLOTS = 41;
+
+    /** A written book is the realistic worst case; anything past this is not an item, it is a bug. */
+    private const MAX_NBT_BYTES = 256 * 1024;
+
+    private NetworkNbtSerializer $nbt;
+
+    /** Shared by `parseItem()`, which is static because the entity mirror builds items too. */
+    private static ?NetworkNbtSerializer $codec = null;
+
+    /** Shared by `tupleFor()`, for the same reason: container content needs the same dialect. */
+    private static ?NetworkNbtSerializer $tupleCodec = null;
+
+    /** @var array<string, array<int, string>> uuid => slot => fingerprint */
+    private array $shadow = [];
+
+    /** @var array<string, true> */
+    private array $reported = [];
+
+    public function __construct()
+    {
+        $this->nbt = new NetworkNbtSerializer();
+    }
+
+    public function forget(string $uuid): void
+    {
+        unset($this->shadow[$uuid]);
+    }
+
+    /**
+     * Drops every shadow, which is what makes the next diff a full snapshot.
+     *
+     * Called when a host connects: a process that has just booted has empty inventories, and
+     * keeping shadows from the previous process would leave it believing it already knew them.
+     */
+    public function forgetAll(): void
+    {
+        $this->shadow = [];
+        $this->reported = [];
+    }
+
+    /**
+     * @return array{slots: list<array<int, int|string>>, gaps: list<string>}
+     */
+    public function diff(string $uuid, Player $player): array
+    {
+        $after = $this->snapshot($player);
+        $before = $this->shadow[$uuid] ?? null;
+        $this->shadow[$uuid] = $after;
+
+        // No shadow means "a host has not seen this player yet": send everything that is not air.
+        // The state mirror suppresses the first poll instead, because the join frame carries the
+        // position; nothing carries an inventory, so this is where the first copy comes from.
+        $first = $before === null;
+
+        $slots = [];
+        $gaps = [];
+        foreach ($after as $slot => $fingerprint) {
+            if ($first) {
+                if ($fingerprint === 'air' || $fingerprint === 'opaque') {
+                    continue;
+                }
+            } elseif ($before[$slot] === $fingerprint) {
+                continue;
+            }
+            if ($fingerprint === 'opaque') {
+                // An item this side cannot name. Reporting it would mean inventing an id, and
+                // marking it as air would delete it on the other side.
+                $gap = $this->gapFor($slot);
+                if ($gap !== null) {
+                    $gaps[] = $gap;
+                }
+                continue;
+            }
+            $slots[] = $this->tuple($slot, self::itemAt($player, $slot));
+        }
+
+        return ['slots' => $slots, 'gaps' => $gaps];
+    }
+
+    /**
+     * Applies slot writes Nukkit detected, then re-seeds the shadow from the result.
+     *
+     * @param list<array<int, mixed>> $slots
+     *
+     * @return list<string> reasons a slot could not be applied verbatim
+     */
+    public function apply(BridgedPlayer $player, array $slots): array
+    {
+        $gaps = [];
+        foreach ($slots as $entry) {
+            if (!is_array($entry) || count($entry) < 3) {
+                $gaps[] = 'malformed slot entry';
+                continue;
+            }
+            $slot = (int) $entry[0];
+            if ($slot < 0 || $slot >= self::SLOTS) {
+                $gaps[] = 'slot ' . $slot . ' is outside the mirrored range';
+                continue;
+            }
+
+            $id = (string) $entry[1];
+            $count = (int) $entry[2];
+            $meta = (int) ($entry[3] ?? 0);
+            $nbt = isset($entry[4]) && is_string($entry[4]) && $entry[4] !== '' ? $entry[4] : null;
+
+            $item = $this->build($id, $count, $meta, $nbt, $slot, $gaps);
+            if ($item === null) {
+                continue;
+            }
+
+            try {
+                self::inventoryAt($player, $slot)->setItem(self::indexAt($slot), $item);
+            } catch (\Throwable $e) {
+                // Armour slots validate their contents; a plugin putting a diamond in the helmet
+                // slot is a mistake on the plugin's side, not a reason to stop the tick.
+                $gaps[] = 'slot ' . $slot . ' refused ' . $id . ': ' . $e->getMessage();
+            }
+        }
+
+        $this->shadow[$player->getBridgeId()] = $this->snapshot($player);
+        return $gaps;
+    }
+
+    /**
+     * @param list<string> $gaps
+     */
+    private function build(string $id, int $count, int $meta, ?string $encodedNbt, int $slot, array &$gaps): ?Item
+    {
+        [$item, $reason] = self::parseItem($id, $count, $meta, $encodedNbt);
+        if ($item === null) {
+            $gaps[] = 'slot ' . $slot . ': ' . $reason;
+        }
+        return $item;
+    }
+
+    /**
+     * Turns the item dialect into an item.
+     *
+     * The dialect is `(flattened id, count, damage, optional network NBT)`. It is public because
+     * the entity mirror needs exactly the same translation for dropped stacks: `minecraft:item`
+     * carries one of these inside its save data. Reasons come back instead of being written to a
+     * slot-specific gap so each caller can say what it was trying to build.
+     *
+     * @return array{0: ?Item, 1: ?string} the item, or the reason it could not be built
+     */
+    public static function parseItem(string $id, int $count, int $meta, ?string $encodedNbt): array
+    {
+        if ($count <= 0 || $id === '' || $id === 'minecraft:air') {
+            return [VanillaItems::AIR(), null];
+        }
+
+        $item = StringToItemParser::getInstance()->parse($id);
+        if ($item === null) {
+            return [null, 'no item named ' . $id];
+        }
+
+        $item->setCount(min($count, $item->getMaxStackSize()));
+
+        // Meta is durability damage now: variants are already part of the flattened name. A
+        // non-durable item that arrives with a non-zero meta is not an error worth a line - the
+        // sender could only have got that from a legacy item - it just has nowhere to go.
+        if ($meta > 0 && $item instanceof Durable) {
+            try {
+                $item->setDamage(min($meta, $item->getMaxDurability()));
+            } catch (\InvalidArgumentException) {
+                // Already clamped above; this is belt and braces for items reporting max 0.
+            }
+        }
+
+        if ($encodedNbt !== null) {
+            $raw = base64_decode($encodedNbt, true);
+            if ($raw === false || strlen($raw) > self::MAX_NBT_BYTES) {
+                return [null, 'item NBT is not base64 or is over the size limit'];
+            }
+            try {
+                $codec = self::$codec ??= new NetworkNbtSerializer();
+                $item->setNamedTag($codec->read($raw)->mustGetCompoundTag());
+            } catch (\Throwable $e) {
+                // An NBT blob this build cannot parse would otherwise replace a good item with a
+                // half-configured one. Drop the write and say so.
+                return [null, 'item NBT could not be read: ' . $e->getMessage()];
+            }
+        }
+
+        return [$item, null];
+    }
+
+    /**
+     * @return array<int, string> slot => fingerprint, `opaque` when the item cannot be named
+     */
+    private function snapshot(Player $player): array
+    {
+        $snapshot = [];
+        for ($slot = 0; $slot < self::SLOTS; $slot++) {
+            $snapshot[$slot] = $this->fingerprintOf(self::itemAt($player, $slot));
+        }
+        return $snapshot;
+    }
+
+    private function fingerprintOf(Item $item): string
+    {
+        if ($item->isNull()) {
+            return 'air';
+        }
+        $name = self::nameOf($item);
+        if ($name === null) {
+            return 'opaque';
+        }
+        $nbt = '';
+        if ($item->hasNamedTag()) {
+            try {
+                $nbt = base64_encode($this->nbt->write(new TreeRoot($item->getNamedTag())));
+            } catch (\Throwable) {
+                return 'opaque';
+            }
+        }
+        $meta = $item instanceof Durable ? $item->getDamage() : 0;
+        return $name . '|' . $item->getCount() . '|' . $meta . '|' . $nbt;
+    }
+
+    /**
+     * The name the other side will resolve. `lookupAliases()` is the reverse of the same table
+     * `/give` parses with, so the first alias is the most specific registered name for this
+     * exact state (`white_wool` before `wool` for white wool).
+     */
+    private static function nameOf(Item $item): ?string
+    {
+        $aliases = StringToItemParser::getInstance()->lookupAliases($item);
+        if ($aliases === []) {
+            return null;
+        }
+        $name = $aliases[0];
+        return str_contains($name, ':') ? $name : 'minecraft:' . $name;
+    }
+
+    /**
+     * @return array<int, int|string>
+     */
+    private function tuple(int $slot, Item $item): array
+    {
+        return self::tupleFor($slot, $item);
+    }
+
+    /**
+     * The slot-bearing form of the item dialect, for container content.
+     *
+     * Public because a window is not a player slot: the window mirror has the same item problem
+     * but none of this class's shadow bookkeeping. Sharing the translator is what keeps a
+     * renamed sword identical in a chest and in an inventory.
+     *
+     * @return array<int, int|string>
+     */
+    public static function tupleFor(int $slot, Item $item): array
+    {
+        $name = $item->isNull() ? null : self::nameOf($item);
+        if ($name === null) {
+            return [$slot, 'minecraft:air', 0, 0];
+        }
+        $tuple = [
+            $slot,
+            $name,
+            $item->getCount(),
+            $item instanceof Durable ? $item->getDamage() : 0,
+        ];
+        if ($item->hasNamedTag()) {
+            try {
+                $tuple[] = base64_encode((self::$tupleCodec ??= new NetworkNbtSerializer())->write(new TreeRoot($item->getNamedTag())));
+            } catch (\Throwable) {
+                // The fingerprint already treated this as representable, so the item still
+                // travels; only the extra data is lost. Sending it without NBT is closer to the
+                // truth than not sending the item at all.
+            }
+        }
+        return $tuple;
+    }
+
+    public static function inventoryAt(Player $player, int $slot): Inventory
+    {
+        if ($slot < self::SLOT_INVENTORY) {
+            return $player->getInventory();
+        }
+        if ($slot < self::SLOT_OFFHAND) {
+            return $player->getArmorInventory();
+        }
+        return $player->getOffHandInventory();
+    }
+
+    public static function indexAt(int $slot): int
+    {
+        if ($slot < self::SLOT_INVENTORY) {
+            return $slot;
+        }
+        if ($slot < self::SLOT_OFFHAND) {
+            return $slot - self::SLOT_INVENTORY;
+        }
+        return 0;
+    }
+
+    private static function itemAt(Player $player, int $slot): Item
+    {
+        return self::inventoryAt($player, $slot)->getItem(self::indexAt($slot));
+    }
+
+    private function gapFor(int $slot): ?string
+    {
+        $message = 'slot ' . $slot . ' holds an item this build cannot name; not mirrored';
+        if (isset($this->reported[$message])) {
+            return null;
+        }
+        $this->reported[$message] = true;
+        return $message;
+    }
+}
diff --git a/src/mukkit/BridgePlayerState.php b/src/mukkit/BridgePlayerState.php
new file mode 100644
index 000000000..398fb9db1
--- /dev/null
+++ b/src/mukkit/BridgePlayerState.php
@@ -0,0 +1,273 @@
+<?php
+
+declare(strict_types=1);
+
+namespace pocketmine\mukkit;
+
+use pocketmine\player\GameMode;
+use pocketmine\player\Player;
+
+/**
+ * Two-way mirror of the player state a plugin can change.
+ *
+ * Same shape as `BridgeWorldMirror`, and for the same reason: PocketMine's own packet paths for
+ * this state are not reachable from a session nobody logged into. `setHealth()` sends no packet
+ * at all in PM5 (health rides on the attribute packet), game mode sync reaches for a private
+ * `$player` field, and inventory sync hangs off an `InventoryManager` that the login flow
+ * constructs. Diffing the public API is both simpler and more complete than reproducing login:
+ * it also catches changes made through paths that never produce a packet.
+ *
+ * The rule is last-writer-wins with echo suppression. Whichever side changed a field first
+ * becomes the shadow, so the other side's next diff has nothing to report. Without that, every
+ * mirrored change would bounce back and forth for as long as the server runs.
+ */
+final class BridgePlayerState{
+	/** Sub-millimetre: anything smaller is float noise from two different coordinate pipelines. */
+	private const POSITION_EPSILON = 0.001;
+
+	/** A tenth of a degree is well below what a client renders. */
+	private const ROTATION_EPSILON = 0.05;
+
+	private const HEALTH_EPSILON = 0.001;
+
+	/** A hundredth of a level bar is below what either client draws. */
+	private const PROGRESS_EPSILON = 0.001;
+
+	/** Food and saturation are unitless half-hearts; a thousandth is float noise. */
+	private const HUNGER_EPSILON = 0.001;
+
+	/** @var array<string, array<string, mixed>> */
+	private array $shadow = [];
+
+	/**
+	 * Seeds the shadow, which is what makes a join produce no state op: the player is where
+	 * Nukkit put it and nothing has changed yet.
+	 *
+	 * `$joinHeldSlot` is what Nukkit said on the join frame, not what the player's inventory says
+	 * now. A plugin that selects a hotbar slot inside `PlayerJoinEvent` has changed the state a
+	 * moment after the frame arrived; seeding the post-event value would absorb that change and
+	 * Nukkit would never hear about it. Only the held slot is seeded this way - position is left
+	 * at the player's current value because upstream normalises angles, and seeding the raw join
+	 * value would fake a move in the same tick's diff.
+	 */
+	public function remember(string $uuid, Player $player, ?int $joinHeldSlot = null) : void{
+		$state = self::snapshot($player);
+		if($joinHeldSlot !== null){
+			$state["heldSlot"] = $joinHeldSlot;
+		}
+		$this->shadow[$uuid] = $state;
+	}
+
+	public function forget(string $uuid) : void{
+		unset($this->shadow[$uuid]);
+	}
+
+	public function isTracking(string $uuid) : bool{
+		return isset($this->shadow[$uuid]);
+	}
+
+	/**
+	 * Reports what PocketMine changed since the last look.
+	 *
+	 * Only the changed fields travel. Position and rotation travel as one group: a teleport that
+	 * kept the old yaw looks like a glitch, and the client needs all five values to be placed.
+	 *
+	 * @return array<string, mixed>
+	 */
+	public function diff(string $uuid, Player $player) : array{
+		$after = self::snapshot($player);
+		$before = $this->shadow[$uuid] ?? null;
+		$this->shadow[$uuid] = $after;
+		if($before === null){
+			return [];
+		}
+
+		$changed = [];
+		if(
+			abs($before["x"] - $after["x"]) > self::POSITION_EPSILON ||
+			abs($before["y"] - $after["y"]) > self::POSITION_EPSILON ||
+			abs($before["z"] - $after["z"]) > self::POSITION_EPSILON ||
+			abs($before["yaw"] - $after["yaw"]) > self::ROTATION_EPSILON ||
+			abs($before["pitch"] - $after["pitch"]) > self::ROTATION_EPSILON
+		){
+			foreach(["x", "y", "z", "yaw", "pitch"] as $key){
+				$changed[$key] = $after[$key];
+			}
+		}
+		if(abs($before["health"] - $after["health"]) > self::HEALTH_EPSILON){
+			$changed["health"] = $after["health"];
+		}
+		if($before["maxHealth"] !== $after["maxHealth"]){
+			$changed["maxHealth"] = $after["maxHealth"];
+		}
+		if($before["gamemode"] !== $after["gamemode"]){
+			$changed["gamemode"] = $after["gamemode"];
+		}
+		//The selected hotbar slot is a position in the inventory, not inventory content: one
+		//small int, so pressing a hotbar key does not ship 41 item stacks to Nukkit.
+		if($before["heldSlot"] !== $after["heldSlot"]){
+			$changed["heldSlot"] = $after["heldSlot"];
+		}
+		if($before["xpLevel"] !== $after["xpLevel"]){
+			$changed["xpLevel"] = $after["xpLevel"];
+		}
+		if(abs($before["xpProgress"] - $after["xpProgress"]) > self::PROGRESS_EPSILON){
+			$changed["xpProgress"] = $after["xpProgress"];
+		}
+		if(abs($before["food"] - $after["food"]) > self::HUNGER_EPSILON){
+			$changed["food"] = $after["food"];
+		}
+		if(abs($before["saturation"] - $after["saturation"]) > self::HUNGER_EPSILON){
+			$changed["saturation"] = $after["saturation"];
+		}
+		//Effects travel as a whole list, not as per-effect deltas: the list is four entries at
+		//most and a full replacement is the only shape that also expresses "this one expired".
+		if($before["effects"] !== $after["effects"]){
+			$changed["effects"] = $after["effects"];
+		}
+		//Operator status is one bit and it is server-wide, so it travels on its own: a player who
+		//was opped should not also look like they moved.
+		if($before["op"] !== $after["op"]){
+			$changed["op"] = $after["op"];
+		}
+
+		return $changed;
+	}
+
+	/**
+	 * Applies what Nukkit says happened, then re-seeds the shadow from the result.
+	 *
+	 * Re-seeding from the player rather than from `$state` matters: upstream clamps health to the
+	 * max, a plugin may cancel a game mode change, and the shadow has to record what actually
+	 * happened or the next diff will report a change that never occurred.
+	 *
+	 * @param array<string, mixed> $state
+	 *
+	 * @return list<string> reasons the state could not be applied verbatim
+	 */
+	public function apply(BridgedPlayer $player, array $state) : array{
+		$uuid = $player->getBridgeId();
+		$gaps = [];
+
+		//First: every other field on this frame may be inspected by plugins from a permission
+		//callback, and the operator bit changes what `hasPermission()` answers for all of them.
+		if(isset($state["op"])){
+			foreach(BridgeOps::sync($player->getServer(), $player->getName(), (bool) $state["op"]) as $gap){
+				$gaps[] = "operator: " . $gap;
+			}
+		}
+
+		$x = $state["x"] ?? null;
+		$y = $state["y"] ?? null;
+		$z = $state["z"] ?? null;
+		if($x !== null && $y !== null && $z !== null){
+			$location = $player->getLocation();
+			$player->applyMirroredPosition(
+				(float) $x,
+				(float) $y,
+				(float) $z,
+				(float) ($state["yaw"] ?? $location->yaw),
+				(float) ($state["pitch"] ?? $location->pitch)
+			);
+		}
+
+		//Effects before health: health boost and absorption change the maximum, and the health
+		//value in this same frame is the authoritative one from Nukkit - setting it first would
+		//let the old maximum clamp it.
+		if(array_key_exists("effects", $state)){
+			$rows = is_array($state["effects"]) ? $state["effects"] : [];
+			foreach(BridgeEffects::apply($player, $rows) as $gap){
+				$gaps[] = "effect: " . $gap;
+			}
+		}
+
+		if(isset($state["health"])){
+			//0 is a legitimate value (the player died on Nukkit's side) and has to reach
+			//PocketMine, otherwise a plugin sees a corpse with full health.
+			$player->setHealth(max(0.0, (float) $state["health"]));
+		}
+
+		if(isset($state["gamemode"])){
+			$mode = GameMode::fromString((string) $state["gamemode"]);
+			if($mode === null){
+				$gaps[] = "unknown gamemode " . (string) $state["gamemode"];
+			}elseif(!$player->setGamemode($mode)){
+				//A plugin cancelled PlayerGameModeChangeEvent: PocketMine deliberately disagrees
+				//with Nukkit here, and nothing will reconcile it until one side changes again.
+				$gaps[] = "gamemode change to " . $mode->name . " was cancelled by a plugin";
+			}
+		}
+
+		if(array_key_exists("heldSlot", $state)){
+			$value = $state["heldSlot"];
+			//Only integers are slots. A float that is not integral, a string, or a boolean is a
+			//broken frame; casting it would silently move the player to slot 0.
+			$slot = is_int($value) ? $value : (is_float($value) && $value === floor($value) ? (int) $value : -1);
+			$hotbar = $player->getInventory()->getHotbarSize();
+			if($slot < 0 || $slot >= $hotbar){
+				//No clamping: moving the client's selection somewhere the plugin did not ask for
+				//is worse than leaving it where it was.
+				$gaps[] = "held slot " . (is_scalar($value) ? var_export($value, true) : gettype($value))
+					. " is outside 0-" . ($hotbar - 1);
+			}elseif($player->getInventory()->getHeldItemIndex() !== $slot){
+				//Upstream's own primitive. It fires the held-index listeners, which is how a real
+				//session would sync the client - but a bridged session has no `InventoryManager`.
+				//The adapter sends MobEquipmentPacket when it applies the same field.
+				$player->getInventory()->setHeldItemIndex($slot);
+			}
+		}
+
+		if(isset($state["xpLevel"]) || isset($state["xpProgress"])){
+			$xp = $player->getXpManager();
+			$level = isset($state["xpLevel"]) ? max(0, (int) $state["xpLevel"]) : $xp->getXpLevel();
+			$progress = isset($state["xpProgress"])
+				? min(1.0, max(0.0, (float) $state["xpProgress"]))
+				: $xp->getXpProgress();
+			//No event: a mirror catching up is not a plugin awarding experience, and firing
+			//PlayerExperienceChangeEvent would let an unrelated plugin cancel the sync.
+			$xp->setXpAndProgressNoEvent($level, $progress);
+		}
+
+		if(isset($state["food"]) || isset($state["saturation"])){
+			$hunger = $player->getHungerManager();
+			if(isset($state["food"])){
+				$hunger->setFood(min(20.0, max(0.0, (float) $state["food"])));
+			}
+			if(isset($state["saturation"])){
+				//Saturation is capped at the food level by upstream, so food has to be written
+				//first - otherwise a frame that raises both would clamp saturation to the old value.
+				$hunger->setSaturation(max(0.0, (float) $state["saturation"]));
+			}
+		}
+
+		$this->shadow[$uuid] = self::snapshot($player);
+		return $gaps;
+	}
+
+	/**
+	 * @return array<string, mixed>
+	 */
+	private static function snapshot(Player $player) : array{
+		$location = $player->getLocation();
+		$hunger = $player->getHungerManager();
+		return [
+			"x" => $location->x,
+			"y" => $location->y,
+			"z" => $location->z,
+			"yaw" => $location->yaw,
+			"pitch" => $location->pitch,
+			"health" => $player->getHealth(),
+			"maxHealth" => $player->getMaxHealth(),
+			"gamemode" => strtolower($player->getGamemode()->name),
+			//Which of the nine hotbar slots the player is holding. Without it `getItemInHand()`
+			//always answers with slot 0, whoever the client actually selected.
+			"heldSlot" => $player->getInventory()->getHeldItemIndex(),
+			"xpLevel" => $player->getXpManager()->getXpLevel(),
+			"xpProgress" => $player->getXpManager()->getXpProgress(),
+			"food" => $hunger->getFood(),
+			"saturation" => $hunger->getSaturation(),
+			"effects" => BridgeEffects::snapshot($player->getEffects()),
+			"op" => BridgeOps::isOperator($player),
+		];
+	}
+}
diff --git a/src/mukkit/BridgeWorldData.php b/src/mukkit/BridgeWorldData.php
new file mode 100644
index 000000000..faba1ab4d
--- /dev/null
+++ b/src/mukkit/BridgeWorldData.php
@@ -0,0 +1,77 @@
+<?php
+
+declare(strict_types=1);
+
+namespace pocketmine\mukkit;
+
+use pocketmine\math\Vector3;
+use pocketmine\world\format\io\WorldData;
+
+/**
+ * World metadata for a world Nukkit owns.
+ *
+ * Nothing here is ever written to disk: the bridge world exists so that `Player` has the
+ * `World` it requires (its constructor registers a chunk loader/listener against one), not so
+ * that PocketMine can simulate terrain. Nukkit is the only authority on block state.
+ */
+final class BridgeWorldData implements WorldData{
+	private string $name;
+	private Vector3 $spawn;
+	private int $time = 6000;
+
+	public function __construct(string $name, ?Vector3 $spawn = null){
+		$this->name = $name;
+		$this->spawn = $spawn ?? new Vector3(0, 64, 0);
+	}
+
+	public function save() : void{
+		//the bridge never persists a world it does not own
+	}
+
+	public function getName() : string{ return $this->name; }
+
+	public function setName(string $value) : void{ $this->name = $value; }
+
+	/**
+	 * Not "flat": `Flat::__construct()` eagerly builds a base chunk, and a chunk needs
+	 * `PalettedBlockArray` from ext-chunkutils2 - the one extension this build will not
+	 * polyfill. "normal" is a lazily-created generator behind an async executor, so the world
+	 * can exist without ever producing terrain.
+	 *
+	 * Nothing generates anything: `BridgeWorldProvider::loadChunk()` returns null, and the
+	 * bridged player never gets a client view distance (so it never orders chunks).
+	 */
+	public function getGenerator() : string{ return "normal"; }
+
+	public function getGeneratorOptions() : string{ return ""; }
+
+	public function getSeed() : int{ return 0; }
+
+	public function getTime() : int{ return $this->time; }
+
+	public function setTime(int $value) : void{ $this->time = $value; }
+
+	public function getSpawn() : Vector3{ return $this->spawn; }
+
+	public function setSpawn(Vector3 $pos) : void{ $this->spawn = $pos; }
+
+	public function getDifficulty() : int{ return 1; }
+
+	public function setDifficulty(int $difficulty) : void{}
+
+	public function getRainTime() : int{ return 0; }
+
+	public function setRainTime(int $ticks) : void{}
+
+	public function getRainLevel() : float{ return 0.0; }
+
+	public function setRainLevel(float $level) : void{}
+
+	public function getLightningTime() : int{ return 0; }
+
+	public function setLightningTime(int $ticks) : void{}
+
+	public function getLightningLevel() : float{ return 0.0; }
+
+	public function setLightningLevel(float $level) : void{}
+}
diff --git a/src/mukkit/BridgeWorldMirror.php b/src/mukkit/BridgeWorldMirror.php
new file mode 100644
index 000000000..c43e9a502
--- /dev/null
+++ b/src/mukkit/BridgeWorldMirror.php
@@ -0,0 +1,765 @@
+<?php
+
+declare(strict_types=1);
+
+namespace pocketmine\mukkit;
+
+use pocketmine\block\Block;
+use pocketmine\block\tile\Container;
+use pocketmine\block\tile\Furnace;
+use pocketmine\block\tile\MonsterSpawner;
+use pocketmine\block\tile\Nameable;
+use pocketmine\block\tile\Sign;
+use pocketmine\block\tile\Tile;
+use pocketmine\block\tile\TileFactory;
+use pocketmine\data\bedrock\BiomeIds;
+use pocketmine\nbt\NBT;
+use pocketmine\nbt\tag\CompoundTag;
+use pocketmine\nbt\tag\ListTag;
+use pocketmine\world\format\Chunk;
+use pocketmine\world\format\PalettedBlockArray;
+use pocketmine\world\format\SubChunk;
+use pocketmine\world\World;
+
+/**
+ * A read/write mirror of the chunks Nukkit has told us about.
+ *
+ * The consistency rule is the one from the roadmap: **the mirror may lag by one tick, but it must
+ * never show a value the server has not produced yet.** That is why inbound updates are applied
+ * before PocketMine's tick and local writes are collected after it - within one tick the ordering
+ * is "theirs, then ours", never the other way around.
+ *
+ * Reads come from real `Chunk` objects inside a real `World`, so `$world->getBlock()` goes through
+ * PocketMine's own state registry, block factory and position handling. Nothing here reimplements
+ * a `pocketmine\*` API (see adr/0001).
+ *
+ * Writes are detected by diffing dirty chunks against a shadow copy of the packed subchunk data.
+ * Diffing rather than intercepting is deliberate: plugins can change blocks through
+ * `World::setBlock()`, `Block::setBlock()`, `World::useItemOn()` and probably a dozen other paths,
+ * and a diff catches all of them, including the ones added by future PM versions.
+ */
+final class BridgeWorldMirror{
+
+	/**
+	 * 4096 entries per section, spelled with PocketMine's own constant on purpose.
+	 *
+	 * `PalettedBlockArray` has no `SIZE`/`EDGE_LENGTH` constant: the extension (the real one, and
+	 * the only one this build ships with) exposes methods only. Those constants only ever existed
+	 * on the userland stand-in in `src/mukkit/polyfill/chunkutils2.php`, so code that used them
+	 * ran fine on a dev box with stock PHP and died with `Undefined constant` on the bundled pmmp
+	 * PHP, where `extension_loaded("chunkutils2")` skips the stand-in. See the class docblock in
+	 * the polyfill: it may only expose what the extension exposes.
+	 */
+	private const SECTION_VOLUME = SubChunk::EDGE_LENGTH ** 3;
+
+	/** @var string|null 4096 little-endian uint32 of zeros: a subchunk that is entirely air. */
+	private static ?string $airSection = null;
+
+	/** @var array<int, array{x: int, z: int, sections: array<int, string>}> chunkHash => shadow */
+	private array $shadow = [];
+
+	/**
+	 * Block entities this world knows about, keyed by position.
+	 *
+	 * The fingerprint is the tile's full observable state in the bridge dialect. Tiles have no
+	 * dirty flag and no "changed" event that covers every write path (a plugin can edit a chest
+	 * inventory, a sign, a furnace counter), so local writes are found the same way block writes
+	 * are: by comparing against the value Nukkit last produced.
+	 *
+	 * @var array<string, array{x: int, y: int, z: int, type: string, fingerprint: string}>
+	 */
+	private array $tiles = [];
+
+	private int $droppedWrites = 0;
+
+	public function __construct(
+		private readonly World $world
+	){}
+
+	private static function airSection(): string
+	{
+		return self::$airSection ??= str_repeat("\x00", self::SECTION_VOLUME * 4);
+	}
+
+	/**
+	 * Replaces a chunk with the snapshot Nukkit sent.
+	 *
+	 * `World::setChunk()` is upstream's own replacement path: it removes the old chunk, transfers
+	 * tiles and clears the "known ungenerated" cache, which is exactly what a fresh authoritative
+	 * snapshot needs.
+	 *
+	 * `$sections` carries Nukkit's dialect (16-bit per-block IDs + 4-bit metas); the state IDs are
+	 * produced here, because they are PocketMine's own numbering and must never travel on the wire.
+	 *
+	 * @param array<int, array{ids: string, metas: string}> $sections absolute section Y => raw arrays
+	 * @param list<array<string, mixed>> $tiles block entities that came with the snapshot
+	 * @return list<string> reasons some tile could not be represented
+	 */
+	public function applyChunk(int $chunkX, int $chunkZ, array $sections, array $tiles = []): array
+	{
+		$converted = [];
+		foreach ($sections as $sectionY => $raw) {
+			$packed = $this->convertSection((int) $sectionY, $raw['ids'], $raw['metas']);
+			if ($packed !== null) {
+				$converted[$sectionY] = $packed;
+			}
+		}
+
+		$chunk = $this->buildChunk($converted);
+		$this->world->setChunk($chunkX, $chunkZ, $chunk);
+		// The snapshot is what Nukkit says it is; it is not a local edit waiting to be written back.
+		$chunk->clearTerrainDirtyFlags();
+
+		$this->shadow[World::chunkHash($chunkX, $chunkZ)] = [
+			'x' => $chunkX,
+			'z' => $chunkZ,
+			'sections' => $converted,
+		];
+
+		return $this->replaceTiles($chunkX, $chunkZ, $tiles);
+	}
+
+	/**
+	 * Applies the block entities that came with a chunk snapshot.
+	 *
+	 * The list is authoritative for the chunk: a tile that existed here and is no longer listed
+	 * was broken while the host was not watching, and keeping it would leave a chest that clients
+	 * already see as air.
+	 *
+	 * @param list<array<string, mixed>> $tiles
+	 * @return list<string>
+	 */
+	private function replaceTiles(int $chunkX, int $chunkZ, array $tiles): array
+	{
+		$wanted = [];
+		foreach ($tiles as $tile) {
+			if (is_array($tile) && isset($tile['x'], $tile['y'], $tile['z'], $tile['type'])) {
+				$wanted[self::tileKey((int) $tile['x'], (int) $tile['y'], (int) $tile['z'])] = true;
+			}
+		}
+
+		$chunk = $this->world->getChunk($chunkX, $chunkZ);
+		if ($chunk !== null) {
+			foreach ($chunk->getTiles() as $existing) {
+				$position = $existing->getPosition();
+				if (!isset($wanted[self::tileKey($position->getFloorX(), $position->getFloorY(), $position->getFloorZ())])) {
+					$existing->close();
+				}
+			}
+		}
+
+		$gaps = [];
+		foreach ($tiles as $tile) {
+			if (!is_array($tile)) {
+				continue;
+			}
+			$gap = $this->applyTile($tile);
+			if ($gap !== null) {
+				$gaps[] = $gap;
+			}
+		}
+
+		// Drop the shadow entries for tiles this snapshot no longer lists. A tile whose snapshot
+		// failed keeps its old fingerprint on purpose: the chest then stops updating (visible and
+		// reported) instead of silently losing the item PM could not name.
+		foreach ($this->tiles as $key => $entry) {
+			if (
+				($entry['x'] >> Chunk::COORD_BIT_SIZE) === $chunkX &&
+				($entry['z'] >> Chunk::COORD_BIT_SIZE) === $chunkZ &&
+				!isset($wanted[$key])
+			) {
+				unset($this->tiles[$key]);
+			}
+		}
+		return $gaps;
+	}
+
+	/**
+	 * Applies one block-entity snapshot.
+	 *
+	 * Tiles are attached with {@see Chunk::addTile()}, not {@see World::addTile()}: the latter
+	 * schedules a block update, and a mirrored world must not tick tiles on its own. Nukkit owns
+	 * the simulation - the furnace here is a view of Nukkit's furnace, not a second one.
+	 *
+	 * @param array<string, mixed> $tile
+	 * @return string|null why the tile could not be represented, or null on success
+	 */
+	public function applyTile(array $tile): ?string
+	{
+		$x = (int) ($tile['x'] ?? 0);
+		$y = (int) ($tile['y'] ?? 0);
+		$z = (int) ($tile['z'] ?? 0);
+		$type = (string) ($tile['type'] ?? '');
+		if ($type === '') {
+			return 'tile without a type at ' . $x . ',' . $y . ',' . $z;
+		}
+		if (!$this->world->isInWorld($x, $y, $z)) {
+			return 'tile ' . $type . ' outside the world at ' . $x . ',' . $y . ',' . $z;
+		}
+
+		$factory = TileFactory::getInstance();
+		$existing = $this->world->getTileAt($x, $y, $z);
+		try {
+			// Building the NBT parses item stacks; a malformed tuple throws inside the same guard
+			// as the tile construction so one bad tile cannot abort the rest of the frame.
+			$nbt = $this->buildTileNbt($tile, $x, $y, $z);
+			if ($nbt === null) {
+				return 'tile ' . $type . ' at ' . $x . ',' . $y . ',' . $z . ' has no usable snapshot';
+			}
+			if (
+				$existing !== null &&
+				$factory->isRegistered($existing::class) &&
+				$factory->getSaveId($existing::class) === $type
+			) {
+				$existing->readSaveData($nbt);
+				$real = $existing;
+			} else {
+				if ($existing !== null) {
+					// close(), not onBlockDestroyed(): the tile's contents are Nukkit's problem.
+					$existing->close();
+				}
+				$real = $factory->createFromData($this->world, $nbt);
+				if ($real === null) {
+					return 'tile type ' . $type . ' has no PocketMine counterpart';
+				}
+				$chunk = $this->world->getChunk($x >> Chunk::COORD_BIT_SIZE, $z >> Chunk::COORD_BIT_SIZE);
+				if ($chunk === null) {
+					return 'tile ' . $type . ' at ' . $x . ',' . $y . ',' . $z . ' arrived before its chunk';
+				}
+				$chunk->addTile($real);
+			}
+		} catch (\Throwable $e) {
+			return 'tile ' . $type . ' at ' . $x . ',' . $y . ',' . $z . ' could not be applied: ' . $e->getMessage();
+		}
+
+		// `readSaveData()` only writes the pair when the tags are present, so an unpaired snapshot
+		// has to clear a pairing the tile had before. Otherwise a chest stays glued to a neighbour
+		// that Nukkit no longer considers its pair.
+		if ($real instanceof \pocketmine\block\tile\Chest && (!isset($tile['pairx']) || !isset($tile['pairz']))) {
+			$real->unpair();
+		}
+
+		$this->tiles[self::tileKey($x, $y, $z)] = [
+			'x' => $x,
+			'y' => $y,
+			'z' => $z,
+			'type' => $type,
+			'fingerprint' => self::fingerprintTile($real),
+		];
+		return null;
+	}
+
+	/**
+	 * Forgets a block entity Nukkit says is gone.
+	 *
+	 * The block update that accompanies it already reached the world through `applyRemoteBlock()`;
+	 * this only removes the tile object, so `getTile()` and the next diff both stop seeing it.
+	 */
+	public function removeTileAt(int $x, int $y, int $z): void
+	{
+		unset($this->tiles[self::tileKey($x, $y, $z)]);
+		$this->world->getTileAt($x, $y, $z)?->close();
+	}
+
+	/**
+	 * Collects local tile edits since the last call.
+	 *
+	 * Same contract as {@see takeChanges()}: the shadow is advanced before the payload is built,
+	 * so one edit is reported once even when the encoded form loses a detail PM could not keep.
+	 *
+	 * @return list<array<string, mixed>>
+	 */
+	public function takeTileChanges(int $limit = 256): array
+	{
+		$changes = [];
+		foreach ($this->tiles as $key => $entry) {
+			if (count($changes) >= $limit) {
+				break;
+			}
+			$tile = $this->world->getTileAt($entry['x'], $entry['y'], $entry['z']);
+			if ($tile === null) {
+				// The block was replaced locally; the block diff already tells Nukkit to break it,
+				// and the tile that comes back (if any) will be a fresh snapshot.
+				unset($this->tiles[$key]);
+				continue;
+			}
+			$fingerprint = self::fingerprintTile($tile);
+			if ($fingerprint === $entry['fingerprint']) {
+				continue;
+			}
+			$this->tiles[$key]['fingerprint'] = $fingerprint;
+			$payload = self::encodeTile($tile);
+			if ($payload !== null) {
+				$changes[] = $payload;
+			}
+		}
+		return $changes;
+	}
+
+	/**
+	 * The bridge form of a tile, or null for a tile type the other side has no name for.
+	 *
+	 * @return array<string, mixed>|null
+	 */
+	private static function encodeTile(Tile $tile): ?array
+	{
+		$factory = TileFactory::getInstance();
+		if (!$factory->isRegistered($tile::class)) {
+			return null;
+		}
+		$position = $tile->getPosition();
+		$payload = [
+			'x' => $position->getFloorX(),
+			'y' => $position->getFloorY(),
+			'z' => $position->getFloorZ(),
+			'type' => $factory->getSaveId($tile::class),
+		];
+
+		if ($tile instanceof Nameable && $tile->hasName()) {
+			$payload['name'] = $tile->getName();
+		}
+
+		if ($tile instanceof Container) {
+			$items = [];
+			foreach ($tile->getRealInventory()->getContents() as $slot => $item) {
+				$tuple = BridgePlayerInventory::tupleFor($slot, $item);
+				if (($tuple[1] ?? 'minecraft:air') !== 'minecraft:air') {
+					$items[] = $tuple;
+				}
+			}
+			$payload['items'] = $items;
+
+			if ($tile instanceof Furnace) {
+				$save = $tile->getCleanedNBT();
+				$payload['burn'] = $save?->getShort('BurnTime') ?? 0;
+				$payload['cook'] = $save?->getShort('CookTime') ?? 0;
+				$payload['max'] = $save?->getShort('MaxTime') ?? 0;
+			}
+		} elseif ($tile instanceof Sign) {
+			$front = $tile->getText();
+			$back = $tile->getBackText();
+			$payload['front'] = $front->getLines();
+			$payload['frontColor'] = $front->getBaseColor()->toARGB();
+			$payload['frontGlow'] = $front->isGlowing();
+			$payload['back'] = $back->getLines();
+			$payload['backColor'] = $back->getBaseColor()->toARGB();
+			$payload['backGlow'] = $back->isGlowing();
+		} elseif ($tile instanceof MonsterSpawner) {
+			$payload['entity'] = $tile->getCleanedNBT()?->getString('EntityIdentifier') ?? '';
+		}
+
+		return $payload;
+	}
+
+	/**
+	 * The state a tile is compared on. Anything that is written into a payload must appear here,
+	 * or a local edit would never be reported.
+	 */
+	private static function fingerprintTile(Tile $tile): string
+	{
+		if ($tile instanceof Container) {
+			$parts = [];
+			foreach ($tile->getRealInventory()->getContents() as $slot => $item) {
+				$tuple = BridgePlayerInventory::tupleFor($slot, $item);
+				if (($tuple[1] ?? 'minecraft:air') !== 'minecraft:air') {
+					$parts[] = implode('|', $tuple);
+				}
+			}
+			$name = $tile instanceof Nameable && $tile->hasName() ? $tile->getName() : '';
+			$extra = '';
+			if ($tile instanceof Furnace) {
+				$save = $tile->getCleanedNBT();
+				$extra = '|burn=' . ($save?->getShort('BurnTime') ?? 0)
+					. ',cook=' . ($save?->getShort('CookTime') ?? 0)
+					. ',max=' . ($save?->getShort('MaxTime') ?? 0);
+			}
+			return 'items|' . $name . '|' . implode(';', $parts) . $extra;
+		}
+		if ($tile instanceof Sign) {
+			$front = $tile->getText();
+			$back = $tile->getBackText();
+			return 'sign|' . implode("\n", $front->getLines()) . '|' . $front->getBaseColor()->toARGB()
+				. '|' . ($front->isGlowing() ? 1 : 0)
+				. '|' . implode("\n", $back->getLines()) . '|' . $back->getBaseColor()->toARGB()
+				. '|' . ($back->isGlowing() ? 1 : 0);
+		}
+		if ($tile instanceof MonsterSpawner) {
+			return 'spawner|' . ($tile->getCleanedNBT()?->getString('EntityIdentifier') ?? '');
+		}
+		return 'tile|' . $tile::class;
+	}
+
+	/**
+	 * @param array<string, mixed> $tile
+	 */
+	private function buildTileNbt(array $tile, int $x, int $y, int $z): ?CompoundTag
+	{
+		$type = (string) $tile['type'];
+		$nbt = CompoundTag::create()
+			->setString(Tile::TAG_ID, $type)
+			->setInt(Tile::TAG_X, $x)
+			->setInt(Tile::TAG_Y, $y)
+			->setInt(Tile::TAG_Z, $z);
+
+		if (isset($tile['name']) && is_string($tile['name']) && $tile['name'] !== '') {
+			$nbt->setString(Nameable::TAG_CUSTOM_NAME, $tile['name']);
+		}
+
+		if (isset($tile['items']) && is_array($tile['items'])) {
+			$items = [];
+			foreach ($tile['items'] as $tuple) {
+				if (!is_array($tuple) || count($tuple) < 4) {
+					continue;
+				}
+				[$item, $reason] = BridgePlayerInventory::parseItem(
+					(string) ($tuple[1] ?? ''),
+					(int) ($tuple[2] ?? 0),
+					(int) ($tuple[3] ?? 0),
+					isset($tuple[4]) && is_string($tuple[4]) ? $tuple[4] : null
+				);
+				if ($item === null) {
+					return 'tile ' . $type . ' at ' . $x . ',' . $y . ',' . $z . ': ' . ($reason ?? 'unusable item');
+				}
+				if ($item->isNull()) {
+					continue;
+				}
+				$items[] = $item->nbtSerialize((int) ($tuple[0] ?? 0));
+			}
+			$nbt->setTag(Container::TAG_ITEMS, new ListTag($items, NBT::TAG_Compound));
+		}
+
+		switch ($type) {
+			case 'Chest':
+				if (isset($tile['pairx'], $tile['pairz'])) {
+					$nbt->setInt('pairx', (int) $tile['pairx'])->setInt('pairz', (int) $tile['pairz']);
+				}
+				break;
+
+			case 'Furnace':
+			case 'BlastFurnace':
+			case 'Smoker':
+				$nbt->setShort('BurnTime', (int) ($tile['burn'] ?? 0))
+					->setShort('CookTime', (int) ($tile['cook'] ?? 0))
+					->setShort('MaxTime', (int) ($tile['max'] ?? 0));
+				break;
+
+			case 'Sign':
+				$nbt->setTag('FrontText', self::signTextTag($tile['front'] ?? [], $tile['frontColor'] ?? null, (bool) ($tile['frontGlow'] ?? false)));
+				$nbt->setTag('BackText', self::signTextTag($tile['back'] ?? [], $tile['backColor'] ?? null, (bool) ($tile['backGlow'] ?? false)));
+				$nbt->setByte('IsWaxed', 0);
+				break;
+
+			case 'MobSpawner':
+				if (isset($tile['entity']) && is_string($tile['entity']) && $tile['entity'] !== '') {
+					$nbt->setString('EntityIdentifier', $tile['entity']);
+				}
+				break;
+		}
+
+		return $nbt;
+	}
+
+	/**
+	 * @param mixed $lines
+	 * @param mixed $color
+	 */
+	private static function signTextTag($lines, $color, bool $glowing): CompoundTag
+	{
+		$text = [];
+		if (is_array($lines)) {
+			foreach (array_slice($lines, 0, 4) as $line) {
+				$text[] = is_scalar($line) ? (string) $line : '';
+			}
+		}
+		return CompoundTag::create()
+			->setString('Text', implode("\n", $text))
+			->setInt('SignTextColor', is_int($color) ? $color : -16777216)
+			->setByte('IgnoreLighting', $glowing ? 1 : 0)
+			->setByte('PersistFormatting', 1);
+	}
+
+	private static function tileKey(int $x, int $y, int $z): string
+	{
+		return $x . ':' . $y . ':' . $z;
+	}
+
+	/**
+	 * Turns one section's (ID, meta) arrays into PocketMine state IDs.
+	 *
+	 * Returns null when the section is entirely air: `Chunk` already represents that with an empty
+	 * layer list, and keeping a 16 KB all-zero palette per section is pure waste.
+	 */
+	private function convertSection(int $sectionY, string $ids, string $metas): ?string
+	{
+		$expectedIds = self::SECTION_VOLUME * 2;
+		$expectedMetas = self::SECTION_VOLUME;
+		if (strlen($ids) !== $expectedIds || strlen($metas) !== $expectedMetas) {
+			throw new \InvalidArgumentException(
+				"Section $sectionY: expected $expectedIds + $expectedMetas bytes, got " . strlen($ids) . ' + ' . strlen($metas)
+			);
+		}
+
+		$idList = unpack('v*', $ids);
+		$metaList = unpack('C*', $metas);
+		$air = Block::EMPTY_STATE_ID;
+
+		$values = [];
+		$allAir = true;
+		for ($i = 1; $i <= self::SECTION_VOLUME; ++$i) {
+			$id = $idList[$i];
+			$meta = $metaList[$i] & 0x0f;
+			if ($id !== 0 || $meta !== 0) {
+				$allAir = false;
+			}
+			$values[] = BridgeBlocks::stateIdFromIdMeta($id, $meta) ?? $air;
+		}
+		if ($allAir) {
+			return null;
+		}
+		return pack('V*', ...$values);
+	}
+
+	/**
+	 * Applies a block Nukkit changed on its own (player placing, physics, another plugin).
+	 *
+	 * Returns false when the chunk is not mirrored - the caller counts that rather than inventing
+	 * a chunk that would then be missing every other block.
+	 */
+	public function applyRemoteBlock(int $x, int $y, int $z, int $stateId): bool
+	{
+		$chunkX = $x >> Chunk::COORD_BIT_SIZE;
+		$chunkZ = $z >> Chunk::COORD_BIT_SIZE;
+		$hash = World::chunkHash($chunkX, $chunkZ);
+		if (!isset($this->shadow[$hash])) {
+			return false;
+		}
+		if ($y < $this->world->getMinY() || $y >= $this->world->getMaxY()) {
+			return false;
+		}
+
+		$chunk = $this->world->getChunk($chunkX, $chunkZ);
+		if ($chunk === null) {
+			return false;
+		}
+		$chunk->setBlockStateId($x & Chunk::COORD_MASK, $y, $z & Chunk::COORD_MASK, $stateId);
+		$this->writeShadow($hash, $y >> SubChunk::COORD_BIT_SIZE, ($x & 15) | (($z & 15) << 4) | (($y & 15) << 8), $stateId);
+		// This change came *from* Nukkit; sending it back would be an echo.
+		$chunk->clearTerrainDirtyFlags();
+		return true;
+	}
+
+	/**
+	 * Forgets a chunk Nukkit is no longer streaming.
+	 *
+	 * Returns false when PocketMine refuses to unload it (a plugin pinned the chunk, or a
+	 * `ChunkUnloadEvent` was cancelled). The shadow is kept in that case on purpose: the chunk
+	 * is still there, and dropping the shadow would mean the next local write is never reported
+	 * while reads keep returning the old blocks. Keeping both means "still mirrored", which is
+	 * the truth.
+	 */
+	public function unloadChunk(int $chunkX, int $chunkZ) : bool{
+		$hash = World::chunkHash($chunkX, $chunkZ);
+		if(!isset($this->shadow[$hash])){
+			return true;
+		}
+		//`trySave: false`: the bridge provider has no storage, and a mirror is not an authority.
+		if(!$this->world->unloadChunk($chunkX, $chunkZ, true, false)){
+			return false;
+		}
+		unset($this->shadow[$hash]);
+		foreach($this->tiles as $key => $entry){
+			if(($entry['x'] >> Chunk::COORD_BIT_SIZE) === $chunkX && ($entry['z'] >> Chunk::COORD_BIT_SIZE) === $chunkZ){
+				unset($this->tiles[$key]);
+			}
+		}
+		return true;
+	}
+
+	/**
+	 * Collects local edits since the last call.
+	 *
+	 * @return list<array{int, int, int, int, int}> [x, y, z, legacy id, meta]
+	 */
+	public function takeChanges(int $limit = 1024): array
+	{
+		$changes = [];
+		foreach ($this->shadow as $hash => $entry) {
+			if (count($changes) >= $limit) {
+				break;
+			}
+			$chunk = $this->world->getChunk($entry['x'], $entry['z']);
+			if ($chunk === null) {
+				continue;
+			}
+			if (($chunk->getTerrainDirtyFlags() & Chunk::DIRTY_FLAG_BLOCKS) === 0) {
+				continue;
+			}
+
+			for ($sectionY = Chunk::MIN_SUBCHUNK_INDEX; $sectionY <= Chunk::MAX_SUBCHUNK_INDEX; ++$sectionY) {
+				// A section the snapshot omitted is air; a plugin may still have written into it.
+				$before = $entry['sections'][$sectionY] ?? self::airSection();
+				$layers = $chunk->getSubChunk($sectionY)->getBlockLayers();
+				$after = $layers === [] ? self::airSection() : self::packLayer($layers[0]);
+				if ($after === $before) {
+					continue;
+				}
+
+				$old = unpack('V*', $before);
+				$new = unpack('V*', $after);
+				$sectionChanges = [];
+				for ($i = 1; $i <= self::SECTION_VOLUME; ++$i) {
+					if ($old[$i] === $new[$i]) {
+						continue;
+					}
+					$idMeta = BridgeBlocks::idMetaFromStateId($new[$i]);
+					if ($idMeta === null) {
+						// No legacy equivalent: telling Nukkit "air" would be worse than not
+						// telling it anything, because it would destroy the block there.
+						$this->droppedWrites++;
+						continue;
+					}
+					$index = $i - 1;
+					$sectionChanges[] = [
+						$entry['x'] * 16 + ($index & 15),
+						$sectionY * 16 + (($index >> 8) & 15),
+						$entry['z'] * 16 + (($index >> 4) & 15),
+						$idMeta[0],
+						$idMeta[1],
+					];
+				}
+
+				if (count($changes) + count($sectionChanges) > $limit) {
+					// Do not commit the shadow for a section we could not send in full; the chunk
+					// stays dirty and the remainder goes out next tick.
+					break 2;
+				}
+
+				$this->shadow[$hash]['sections'][$sectionY] = $after;
+				array_push($changes, ...$sectionChanges);
+			}
+
+			$chunk->clearTerrainDirtyFlags();
+		}
+
+		return $changes;
+	}
+
+	public function getChunkCount(): int
+	{
+		return count($this->shadow);
+	}
+
+	public function getDroppedWrites(): int
+	{
+		return $this->droppedWrites;
+	}
+
+	/**
+	 * Drops the local edits waiting to be sent.
+	 *
+	 * Used when diffing itself failed: a chunk that could not be read stays dirty, so without
+	 * this the next tick would throw the same thing again and the bridge would never advance -
+	 * one unreadable section would freeze every world, forever. Losing that tick's edits is the
+	 * cheap way out; the shadow still holds what Nukkit last sent, so the next real edit diffs
+	 * against the truth.
+	 */
+	public function discardPendingChanges(): void
+	{
+		foreach ($this->shadow as $entry) {
+			$this->world->getChunk($entry['x'], $entry['z'])?->clearTerrainDirtyFlags();
+		}
+	}
+
+	/**
+	 * @param array<int, string> $sections absolute section Y => packed state IDs
+	 */
+	private function buildChunk(array $sections): Chunk
+	{
+		$subChunks = [];
+		foreach ($sections as $sectionY => $packed) {
+			if (strlen($packed) !== self::SECTION_VOLUME * 4) {
+				throw new \InvalidArgumentException(
+					"Section $sectionY: expected " . (self::SECTION_VOLUME * 4) . ' bytes, got ' . strlen($packed)
+				);
+			}
+			if ($packed === self::airSection()) {
+				// Let Chunk fill in its own default (empty layer list) - cheaper than holding
+				// an all-air palette per section.
+				continue;
+			}
+			$subChunks[$sectionY] = new SubChunk(
+				Block::EMPTY_STATE_ID,
+				[self::buildLayer($packed)],
+				new PalettedBlockArray(BiomeIds::OCEAN)
+			);
+		}
+		$chunk = new Chunk($subChunks, true);
+		//Nukkit owns lighting; nothing in this world will ever run a light population task, and
+		//`World::isChunkTickable()` refuses to tick a chunk whose light is not populated. Without
+		//this the bridged player never ticks, which among other things breaks chat rate limiting.
+		$chunk->setLightPopulated(true);
+		return $chunk;
+	}
+
+	/**
+	 * Turns a packed section (4096 state IDs, XZY order) into a block layer.
+	 *
+	 * Only the extension's public API is used: `new` with a fill entry, then `set()` per block.
+	 * The fill is air, so the entries that already read as air are skipped and an ordinary
+	 * terrain section costs one `set()` per solid block rather than 4096.
+	 */
+	private static function buildLayer(string $packed): PalettedBlockArray
+	{
+		$layer = new PalettedBlockArray(Block::EMPTY_STATE_ID);
+		foreach (unpack('V*', $packed) as $i => $stateId) {
+			if ($stateId === Block::EMPTY_STATE_ID) {
+				continue;
+			}
+			$index = $i - 1;
+			$layer->set($index & 15, ($index >> 8) & 15, ($index >> 4) & 15, $stateId);
+		}
+		return $layer;
+	}
+
+	/**
+	 * Reads a block layer back into the shadow's packed form.
+	 *
+	 * `getPackedData()` was a member of the userland stand-in only; the extension's own
+	 * `getWordArray()` is *packed palette indices* at `getBitsPerBlock()` bits each, which cannot
+	 * be compared with a state-ID payload at all. Reading the section block by block is the
+	 * portable answer, and the uniform case (`getBitsPerBlock() === 0`, i.e. the whole section is
+	 * one entry) keeps the common all-air section at a single `get()`.
+	 */
+	private static function packLayer(PalettedBlockArray $layer): string
+	{
+		if ($layer->getBitsPerBlock() === 0) {
+			return str_repeat(pack('V', $layer->get(0, 0, 0)), self::SECTION_VOLUME);
+		}
+		$packed = str_repeat("\x00", self::SECTION_VOLUME * 4);
+		for ($i = 0; $i < self::SECTION_VOLUME; ++$i) {
+			$stateId = $layer->get($i & 15, ($i >> 8) & 15, ($i >> 4) & 15);
+			$offset = $i << 2;
+			$packed[$offset] = chr($stateId & 0xff);
+			$packed[$offset + 1] = chr(($stateId >> 8) & 0xff);
+			$packed[$offset + 2] = chr(($stateId >> 16) & 0xff);
+			$packed[$offset + 3] = chr(($stateId >> 24) & 0xff);
+		}
+		return $packed;
+	}
+
+	private function writeShadow(int $hash, int $sectionY, int $index, int $stateId): void
+	{
+		$packed = $this->shadow[$hash]['sections'][$sectionY] ?? self::airSection();
+		if (strlen($packed) !== self::SECTION_VOLUME * 4) {
+			return;
+		}
+		// PHP strings are copy-on-write; the shadow and the chunk's palette array can share the
+		// same buffer until one of them is written to.
+		$offset = $index << 2;
+		$packed[$offset] = chr($stateId & 0xff);
+		$packed[$offset + 1] = chr(($stateId >> 8) & 0xff);
+		$packed[$offset + 2] = chr(($stateId >> 16) & 0xff);
+		$packed[$offset + 3] = chr(($stateId >> 24) & 0xff);
+		$this->shadow[$hash]['sections'][$sectionY] = $packed;
+	}
+}
diff --git a/src/mukkit/BridgeWorldProvider.php b/src/mukkit/BridgeWorldProvider.php
new file mode 100644
index 000000000..a869688b6
--- /dev/null
+++ b/src/mukkit/BridgeWorldProvider.php
@@ -0,0 +1,81 @@
+<?php
+
+declare(strict_types=1);
+
+namespace pocketmine\mukkit;
+
+use pocketmine\world\format\Chunk;
+use pocketmine\world\format\io\ChunkData;
+use pocketmine\world\format\io\LoadedChunkData;
+use pocketmine\world\format\io\WritableWorldProvider;
+use pocketmine\world\format\io\WorldData;
+
+/**
+ * An in-memory world provider: every chunk it is asked for exists and is empty (air).
+ *
+ * Why this exists: `Player` cannot be constructed without a `World`, `World` cannot be
+ * constructed without a `WritableWorldProvider`, and the only providers upstream ships are
+ * LevelDB-backed. LevelDB needs the `leveldb` extension, which this build deliberately does not
+ * have. So rather than fake `Player` (plugins type-hint the concrete class), we hand it a real
+ * world whose terrain is "nothing" - which is also the honest description of a world whose
+ * blocks live on the Nukkit side.
+ *
+ * Air-only is deliberate: a plugin that reads blocks gets air, not a corruption of real data.
+ * Block reads/writes are M5's problem (world mirroring).
+ */
+final class BridgeWorldProvider implements WritableWorldProvider{
+	public function __construct(
+		private readonly string $path,
+		private readonly BridgeWorldData $worldData
+	){}
+
+	public function getPath() : string{
+		return $this->path;
+	}
+
+	public function getWorldData() : WorldData{
+		return $this->worldData;
+	}
+
+	public function getWorldMinY() : int{
+		return -64;
+	}
+
+	public function getWorldMaxY() : int{
+		return 320;
+	}
+
+	/**
+	 * No chunks, ever.
+	 *
+	 * Returning a `Chunk` would mean constructing `PalettedBlockArray`, which lives in
+	 * ext-chunkutils2 - the one extension this build refuses to polyfill (faking packed block
+	 * storage yields silently wrong data). A world with zero chunks is also the truthful
+	 * description: block state lives in Nukkit. `World::loadChunk()` handles the null by marking
+	 * the chunk "known ungenerated", so nothing asks the generator for terrain either.
+	 */
+	public function loadChunk(int $chunkX, int $chunkZ) : ?LoadedChunkData{
+		return null;
+	}
+
+	public function saveChunk(int $chunkX, int $chunkZ, ChunkData $chunkData, int $dirtyFlags) : void{
+		//the bridge world never persists; Nukkit owns the blocks
+	}
+
+	public function doGarbageCollection() : void{}
+
+	public function close() : void{}
+
+	/**
+	 * @return \Generator<int, array{int, int, ChunkData}>
+	 */
+	public function getAllChunks(bool $skipCorrupted = false, ?\Logger $logger = null) : \Generator{
+		if(false){
+			yield [0, 0, new ChunkData([], true, [], [])];
+		}
+	}
+
+	public function calculateChunkCount() : int{
+		return 0;
+	}
+}
diff --git a/src/mukkit/BridgeWorldState.php b/src/mukkit/BridgeWorldState.php
new file mode 100644
index 000000000..8c12fffb6
--- /dev/null
+++ b/src/mukkit/BridgeWorldState.php
@@ -0,0 +1,111 @@
+<?php
+
+declare(strict_types=1);
+
+namespace pocketmine\mukkit;
+
+use pocketmine\world\World;
+
+/**
+ * Two-way mirror of a world's clock.
+ *
+ * `World::tick()` never runs under this bridge, so PocketMine's clock is frozen at whatever the
+ * world was created with. A plugin reading `$world->getTime()` would get 6000 forever, and
+ * `$world->setTime(0)` would change a number no client ever sees. This class carries both
+ * directions: Nukkit's advancing clock reaches the plugin, and a plugin's `setTime()` reaches
+ * Nukkit (which is what sends `SetTimePacket` to the clients).
+ *
+ * Unlike the player and inventory mirrors, this one is keyed by world rather than by player:
+ * there is one clock per world, and every plugin in that world is looking at the same number.
+ *
+ * Echo suppression is the usual rule - after applying what Nukkit sent, re-read the world, so
+ * the next diff has nothing to report. `setTime()` sends a packet to every player in the world,
+ * which the caller must truncate from the session outboxes; this class deliberately does not
+ * touch sessions.
+ */
+final class BridgeWorldState{
+
+	/** @var array<string, array{time: int, stopped: bool}> world folder name => clock */
+	private array $shadow = [];
+
+	/**
+	 * Drops every shadow. A host that has just booted has no clocks; the next diff sends each
+	 * world it can see in full.
+	 */
+	public function forgetAll() : void{
+		$this->shadow = [];
+	}
+
+	/**
+	 * Reports what PocketMine changed since the last look.
+	 *
+	 * The first call for a world returns the whole clock: nothing carried it over the way the
+	 * join frame carries a player's position.
+	 *
+	 * @return array<string, int|bool>
+	 */
+	public function diff(string $name, World $world) : array{
+		$after = self::snapshot($world);
+		$before = $this->shadow[$name] ?? null;
+		$this->shadow[$name] = $after;
+		if($before === null){
+			return $after;
+		}
+
+		$changed = [];
+		if($before["time"] !== $after["time"]){
+			$changed["time"] = $after["time"];
+		}
+		if($before["stopped"] !== $after["stopped"]){
+			$changed["stopped"] = $after["stopped"];
+		}
+		return $changed;
+	}
+
+	/**
+	 * Applies a clock the adapter pushed, then re-seeds the shadow from the world.
+	 *
+	 * @param array<string, mixed> $state
+	 *
+	 * @return list<string> reasons the state could not be applied verbatim
+	 */
+	public function apply(World $world, array $state) : array{
+		$gaps = [];
+
+		if(isset($state["time"])){
+			$world->setTime((int) $state["time"]);
+		}
+
+		if(isset($state["stopped"])){
+			$stopped = (bool) $state["stopped"];
+			//Only call through when it changes: `stopTime()` sends a packet, and the caller has
+			//to truncate it. Skipping the no-op keeps the outbox clean for everything else.
+			if($stopped !== $world->stopTime){
+				if($stopped){
+					$world->stopTime();
+				}else{
+					$world->startTime();
+				}
+			}
+		}
+
+		foreach(array_keys($state) as $key){
+			if($key !== "time" && $key !== "stopped"){
+				$gaps[] = "unknown field " . $key;
+			}
+		}
+
+		$this->shadow[$world->getFolderName()] = self::snapshot($world);
+		return $gaps;
+	}
+
+	/**
+	 * @return array{time: int, stopped: bool}
+	 */
+	private static function snapshot(World $world) : array{
+		return [
+			"time" => $world->getTime(),
+			"stopped" => $world->stopTime,
+		];
+	}
+}
diff --git a/src/mukkit/BridgedPlayer.php b/src/mukkit/BridgedPlayer.php
new file mode 100644
index 000000000..e16386c9c
--- /dev/null
+++ b/src/mukkit/BridgedPlayer.php
@@ -0,0 +1,89 @@
+<?php
+
+declare(strict_types=1);
+
+namespace pocketmine\mukkit;
+
+use pocketmine\form\Form;
+use pocketmine\player\Player;
+use pocketmine\player\PlayerInfo;
+use pocketmine\Server;
+use pocketmine\entity\Location;
+use pocketmine\math\Vector3;
+
+/**
+ * A real `Player` whose client lives in the Nukkit process.
+ *
+ * It is a `Player` and not a stand-in because every plugin signature says `Player`. The only
+ * addition is booking: the bridge's UUID (the same one Nukkit uses, so `packet` ops address the
+ * right client).
+ */
+final class BridgedPlayer extends Player{
+	/**
+	 * Where the bridge's form ids start.
+	 *
+	 * Nukkit keeps its own 0-based counter for `formWindows`, and the adapter has to tell a
+	 * response meant for this class from one meant for a Nukkit plugin using the id alone. Two
+	 * counters that both start at 0 do collide: a Nukkit plugin's third form and a PocketMine
+	 * plugin's third form would share the number, and whichever side asked first would get the
+	 * other side's answer. Starting above anything a Nukkit plugin can plausibly reach makes the
+	 * id space disjoint instead of merely unlikely to clash.
+	 */
+	private const FORM_ID_BASE = 1_000_000;
+
+	private int $formSequence = 0;
+
+	public function __construct(
+		Server $server,
+		BridgedSession $session,
+		PlayerInfo $info,
+		Location $spawn,
+		private readonly string $bridgeId
+	){
+		parent::__construct($server, $session, $info, true, $spawn, null);
+		$session->attachPlayer($this);
+	}
+
+	public function getNetworkSession() : BridgedSession{
+		/** @var BridgedSession $session */
+		$session = $this->networkSession;
+		return $session;
+	}
+
+	/** The dashed UUID string Nukkit knows this player by. */
+	public function getBridgeId() : string{
+		return $this->bridgeId;
+	}
+
+	/**
+	 * Moves the player to where Nukkit says it is.
+	 *
+	 * Deliberately not `teleport()`: that fires `PlayerTeleportEvent` and queues a
+	 * `MovePlayerPacket`, and this is the mirror catching up with the authoritative server, not
+	 * a plugin action. `setPosition()`/`setRotation()` are upstream's own primitives - they are
+	 * just protected, and a subclass is the intended way in.
+	 */
+	public function applyMirroredPosition(float $x, float $y, float $z, float $yaw, float $pitch) : void{
+		$this->setPosition(new Vector3($x, $y, $z));
+		$this->setRotation($yaw, $pitch);
+		//Otherwise the next `processMostRecentMovements()` replays the old movement as if the
+		//client had just sent it, which puts the player straight back where it was.
+		$this->resetLastMovements();
+	}
+
+	/**
+	 * Sends a form whose id comes out of the bridge's own range.
+	 *
+	 * Everything else is upstream's `Player::sendForm()`: the form is registered in `$forms`
+	 * (protected upstream, which is what makes this override possible without patching `Player`)
+	 * so `onFormSubmit()` can find it again when the adapter forwards the player's answer. A
+	 * form whose id never made it into `$forms` would be shown to the player and then silently
+	 * dropped on submit, so the registration is not optional.
+	 */
+	public function sendForm(Form $form) : void{
+		$id = self::FORM_ID_BASE + $this->formSequence++;
+		if($this->getNetworkSession()->onFormSent($id, $form)){
+			$this->forms[$id] = $form;
+		}
+	}
+}
diff --git a/src/mukkit/BridgedPlayers.php b/src/mukkit/BridgedPlayers.php
new file mode 100644
index 000000000..89f393cca
--- /dev/null
+++ b/src/mukkit/BridgedPlayers.php
@@ -0,0 +1,180 @@
+<?php
+
+declare(strict_types=1);
+
+namespace pocketmine\mukkit;
+
+use pocketmine\entity\Skin;
+use pocketmine\player\PlayerInfo;
+use pocketmine\Server;
+use pocketmine\entity\Location;
+use pocketmine\world\World;
+use Ramsey\Uuid\Uuid;
+
+/**
+ * Owns the bridge worlds and the set of players proxied into them.
+ *
+ * There is one `World` per Nukkit level name, created on first sight. They are real `World`
+ * objects over an air-only provider, so `$player->getWorld()` is the world the player is
+ * actually standing in and `$world->getBlockAt()` reads the mirror for that world - a plugin
+ * that teleports a player between a lobby and an arena sees two different `World` objects, not
+ * one world whose blocks happen to change.
+ *
+ * Join and quit go through upstream's own lifecycle (`Server::addOnlinePlayer()` +
+ * `Player::doFirstSpawn()` for join, session disconnect + `Player::onPostDisconnect()` for quit)
+ * rather than being reimplemented here. That is what makes `PlayerJoinEvent` /
+ * `PlayerQuitEvent` reach plugins with a player that behaves like a player.
+ */
+final class BridgedPlayers{
+	/** The world used when Nukkit does not name one (synthetic events, early tests). */
+	private const DEFAULT_WORLD = "mukkit";
+
+	/** @var array<string, World> */
+	private array $worlds = [];
+
+	/** @var array<string, BridgedPlayer> */
+	private array $players = [];
+
+	public function __construct(
+		private readonly Server $server
+	){}
+
+	/**
+	 * @param array{x?: float|int, y?: float|int, z?: float|int, yaw?: float|int, pitch?: float|int, world?: string, heldSlot?: int} $position
+	 */
+	public function join(string $bridgeId, string $name, array $position = []) : BridgedPlayer{
+		if(isset($this->players[$bridgeId])){
+			return $this->players[$bridgeId];
+		}
+
+		$world = $this->world(isset($position["world"]) ? (string) $position["world"] : null);
+		$location = new Location(
+			(float) ($position["x"] ?? 0.5),
+			(float) ($position["y"] ?? 65.0),
+			(float) ($position["z"] ?? 0.5),
+			$world,
+			(float) ($position["yaw"] ?? 0.0),
+			(float) ($position["pitch"] ?? 0.0)
+		);
+
+		//The skin is a placeholder: it never reaches a client (nothing is encoded), but
+		//`PlayerListEntry` asks for one and `Skin` validates its length.
+		$info = new PlayerInfo(
+			$name,
+			Uuid::fromString($bridgeId),
+			new Skin("mukkit-" . $bridgeId, str_repeat("\x00", 64 * 32 * 4)),
+			"en_US"
+		);
+
+		$session = new BridgedSession($this->server, $info);
+		$player = new BridgedPlayer($this->server, $session, $info, $location, $bridgeId);
+
+		//Before `PlayerJoinEvent`, for the same reason the operator bit is: a plugin that reads
+		//`getItemInHand()` in that event must see the slot the client is holding, and after the
+		//event it would be a visible correction instead of the truth.
+		$heldSlot = $position["heldSlot"] ?? null;
+		if(is_int($heldSlot) && $heldSlot >= 0 && $heldSlot < $player->getInventory()->getHotbarSize()){
+			$player->getInventory()->setHeldItemIndex($heldSlot);
+		}
+
+		if(!$this->server->addOnlinePlayer($player)){
+			//PlayerLoginEvent cancelled or the session closed underneath us: the caller must
+			//not see a player that upstream refused.
+			throw new \RuntimeException("PocketMine refused to add player " . $name . " (PlayerLoginEvent)");
+		}
+
+		//Upstream's own pre-spawn completion point: fires PlayerJoinEvent, broadcasts the join
+		//message, marks the player as spawned.
+		$player->doFirstSpawn();
+
+		$this->players[$bridgeId] = $player;
+		return $player;
+	}
+
+	public function quit(string $bridgeId, string $reason = "client disconnected") : ?BridgedPlayer{
+		$player = $this->players[$bridgeId] ?? null;
+		if($player === null){
+			return null;
+		}
+		unset($this->players[$bridgeId]);
+
+		//A player PocketMine already disconnected must not be disconnected a second time:
+		//`Player::disconnect()` runs the whole quit path - the event, the leave broadcast, the
+		//chunk unload - before anything reaches the bridge. `kick()` does exactly that, so by
+		//the time the host sees the packet the event has already fired once.
+		if($player->isConnected()){
+			//`disconnect()` flips the session state and sends the disconnect packet (which only
+			//lands in the outbox); `onPostDisconnect()` is what fires PlayerQuitEvent and takes
+			//the player out of the online list. Upstream would normally call the second one
+			//itself from NetworkSession::disconnect(), but it does so through a private `$player`
+			//field that is null for a session nobody logged into.
+			$player->getNetworkSession()->disconnect($reason);
+			$player->onPostDisconnect($reason, null);
+		}
+
+		return $player;
+	}
+
+	public function get(string $bridgeId) : ?BridgedPlayer{
+		return $this->players[$bridgeId] ?? null;
+	}
+
+	public function getByName(string $name) : ?BridgedPlayer{
+		foreach($this->players as $player){
+			if(strcasecmp($player->getName(), $name) === 0){
+				return $player;
+			}
+		}
+		return null;
+	}
+
+	/**
+	 * @return array<string, BridgedPlayer>
+	 */
+	public function all() : array{
+		return $this->players;
+	}
+
+	/**
+	 * The `World` for a Nukkit level, created on first sight.
+	 *
+	 * Worlds are never removed: a player who leaves an arena and comes back must find the same
+	 * object, and the chunks the mirror already holds for it. Unloading a world while a plugin
+	 * still holds a reference is a far worse failure than keeping an air-only shell around.
+	 */
+	public function world(?string $name = null) : World{
+		$name = ($name === null || $name === "") ? self::DEFAULT_WORLD : $name;
+		if(isset($this->worlds[$name])){
+			return $this->worlds[$name];
+		}
+		//The manager may already have it: `HeadlessServer` builds the default level before plugins
+		//enable, and a plugin could have loaded a world by the same name. Reusing it keeps one
+		//`World` object per name instead of two that plugins would see as different worlds.
+		$existing = $this->server->getWorldManager()->getWorldByName($name);
+		if($existing !== null){
+			return $this->worlds[$name] = $existing;
+		}
+		$world = new World(
+			$this->server,
+			$name,
+			new BridgeWorldProvider(
+				$this->server->getDataPath() . "worlds/" . $name,
+				new BridgeWorldData($name)
+			),
+			$this->server->getAsyncPool()
+		);
+		$this->server->getWorldManager()->registerWorld($world);
+		return $this->worlds[$name] = $world;
+	}
+
+	/**
+	 * The world if it has been created, without creating one.
+	 *
+	 * Used by world-level frames: a clock for a world nobody has joined would otherwise make the
+	 * host build an empty `World` just to hold a number.
+	 */
+	public function worldIfExists(string $name) : ?World{
+		return $this->worlds[$name] ?? null;
+	}
+
+}
diff --git a/src/mukkit/BridgedSession.php b/src/mukkit/BridgedSession.php
new file mode 100644
index 000000000..888aef3b2
--- /dev/null
+++ b/src/mukkit/BridgedSession.php
@@ -0,0 +1,191 @@
+<?php
+
+declare(strict_types=1);
+
+namespace pocketmine\mukkit;
+
+use pocketmine\lang\Translatable;
+use pocketmine\network\mcpe\compression\Compressor;
+use pocketmine\network\mcpe\convert\TypeConverter;
+use pocketmine\network\mcpe\InventoryManager;
+use pocketmine\network\mcpe\NetworkSession;
+use pocketmine\network\NetworkSessionManager;
+use pocketmine\network\mcpe\PacketBroadcaster;
+use pocketmine\network\mcpe\PacketSender;
+use pocketmine\network\mcpe\protocol\ClientboundPacket;
+use pocketmine\network\mcpe\protocol\PacketPool;
+use pocketmine\network\mcpe\protocol\TextPacket;
+use pocketmine\network\mcpe\StandardEntityEventBroadcaster;
+use pocketmine\player\Player;
+use pocketmine\player\PlayerInfo;
+use pocketmine\Server;
+
+/**
+ * A network session with a real socket missing on purpose.
+ *
+ * `Player` insists on a `NetworkSession`, and a lot of plugin-visible API funnels through it
+ * (`sendMessage()` is literally `getNetworkSession()->onChatMessage()`). Rather than reimplement
+ * `Player`, this subclass keeps upstream's object graph and replaces the two things that would
+ * need a client:
+ *
+ *  - `sendDataPacket()` never encodes or writes; packets land in an outbox the bridge drains.
+ *  - `onChatMessage()` translates with the server language instead of the (absent) client's.
+ *
+ * Everything else - rate limiters, handler chain, disconnect bookkeeping - is upstream code,
+ * which is the point: plugins see a normal session, not a stub with holes in it.
+ */
+final class BridgedSession extends NetworkSession{
+	/** @var list<ClientboundPacket> */
+	private array $outbox = [];
+
+	private PlayerInfo $bridgeInfo;
+	private ?Player $bridgePlayer = null;
+
+	/**
+	 * Upstream builds this in `onPlayerCreated()`, which only the network login flow reaches. A
+	 * bridged player never logs in, so `Player::setCurrentWindow()` would throw and every
+	 * container a plugin opens would stay invisible.
+	 *
+	 * The real manager is used rather than a stand-in: it already knows the player's inventory,
+	 * armour, offhand, cursor and crafting grid, assigns window ids, and turns slot changes into
+	 * the same `ContainerOpen` / `InventoryContent` / `InventorySlot` packets a networked player
+	 * would get. Those packets land in the outbox and the bridge maps the container ones.
+	 */
+	private ?InventoryManager $bridgeInvManager = null;
+
+	public function __construct(Server $server, PlayerInfo $info){
+		$this->bridgeInfo = $info;
+
+		//No bytes ever leave this process, so the transport-level collaborators are inert. They
+		//still have to be real instances because upstream's constructor stores them and some
+		//upstream methods reach for them (`onPlayerAdded` asks for a skin adapter).
+		$sender = new class implements PacketSender{
+			public function send(string $payload, bool $immediate, ?int $receiptId) : void{}
+			public function close(string $reason = "unknown reason") : void{}
+		};
+		$broadcaster = new class implements PacketBroadcaster{
+			public function broadcastPackets(array $recipients, array $packets) : void{}
+		};
+		$typeConverter = TypeConverter::getInstance();
+		$compressor = new class implements Compressor{
+			public function decompress(string $payload) : string{ return $payload; }
+			public function compress(string $payload) : string{ return $payload; }
+			public function getNetworkId() : int{ return 0; }
+			public function getCompressionThreshold() : ?int{ return null; }
+		};
+
+		parent::__construct(
+			$server,
+			new NetworkSessionManager(),
+			PacketPool::getInstance(),
+			$sender,
+			$broadcaster,
+			new StandardEntityEventBroadcaster($broadcaster, $typeConverter),
+			$compressor,
+			$typeConverter,
+			"127.0.0.1",
+			0
+		);
+	}
+
+	public function attachPlayer(Player $player) : void{
+		$this->bridgePlayer = $player;
+	}
+
+	public function getPlayer() : ?Player{
+		return $this->bridgePlayer;
+	}
+
+	public function getPlayerInfo() : ?PlayerInfo{
+		return $this->bridgeInfo;
+	}
+
+	/**
+	 * The inventory bookkeeping upstream would have created during login.
+	 *
+	 * Lazily built so a session that never opens a container pays nothing. Returning this from
+	 * `getInvManager()` is also what lets `setCurrentWindow()` and `BaseInventory::onSlotChange()`
+	 * find it: both call the public getter, not the private field upstream sets in
+	 * `onPlayerCreated()`.
+	 */
+	public function getInvManager() : ?InventoryManager{
+		if($this->bridgeInvManager === null && $this->bridgePlayer !== null){
+			$this->bridgeInvManager = new InventoryManager($this->bridgePlayer, $this);
+		}
+		return $this->bridgeInvManager;
+	}
+
+	/**
+	 * Upstream flushes its private manager at the end of `tick()`. Ours is a different object, so
+	 * without this override the queued slot/content packets would sit in the manager's pending
+	 * map forever and a plugin's item change would never reach the client.
+	 */
+	public function tick() : void{
+		parent::tick();
+		$this->bridgeInvManager?->flushPendingUpdates();
+	}
+
+	/**
+	 * Flushes queued slot/content packets without running upstream's session tick.
+	 *
+	 * A bridged session is not registered with the network manager, so `NetworkSession::tick()`
+	 * - and the flush it performs - is never called for it. The host calls this after
+	 * `Server::tick()` and before it drains the outbox, which is the same point upstream would
+	 * have used.
+	 */
+	public function flushInventoryUpdates() : void{
+		$this->bridgeInvManager?->flushPendingUpdates();
+	}
+
+	/**
+	 * @return list<ClientboundPacket>
+	 */
+	public function takeOutbox() : array{
+		$drained = $this->outbox;
+		$this->outbox = [];
+		return $drained;
+	}
+
+	public function outboxSize() : int{
+		return count($this->outbox);
+	}
+
+	/**
+	 * Drops everything queued after `$size` without touching what came before it.
+	 *
+	 * Used when the host applies an inbound state change: upstream reactions to it (a game mode
+	 * change syncs the game type, for one) must not travel back to the side that just told us,
+	 * but packets queued earlier in the same tick are legitimate work and have to survive.
+	 */
+	public function truncateOutbox(int $size) : void{
+		if($size < 0 || $size >= count($this->outbox)){
+			return;
+		}
+		$this->outbox = array_slice($this->outbox, 0, $size);
+	}
+
+	public function sendDataPacket(ClientboundPacket $packet, bool $immediate = false) : bool{
+		$this->outbox[] = $packet;
+		return true;
+	}
+
+	/**
+	 * Upstream uses the client's locale for translations; there is no client, so the server
+	 * language is the only honest choice.
+	 */
+	public function onChatMessage(Translatable|string $message) : void{
+		$text = $message instanceof Translatable ? $this->getServerLanguage()->translate($message) : $message;
+		$this->sendDataPacket(TextPacket::raw($text));
+	}
+
+	public function onJukeboxPopup(Translatable|string $message) : void{
+		$this->onChatMessage($message);
+	}
+
+	private function getServerLanguage() : \pocketmine\lang\Language{
+		if($this->bridgePlayer === null){
+			throw new \LogicException("BridgedSession has no player attached; cannot resolve a language");
+		}
+		return $this->bridgePlayer->getLanguage();
+	}
+}
diff --git a/src/mukkit/HeadlessLogger.php b/src/mukkit/HeadlessLogger.php
new file mode 100644
index 000000000..011ceebb9
--- /dev/null
+++ b/src/mukkit/HeadlessLogger.php
@@ -0,0 +1,84 @@
+<?php
+
+/*
+ * Mukkit: the logger a headless host hands to Server.
+ *
+ * Upstream's MainLogger owns a log file, a crash-dump handler and a log buffer shared with worker
+ * threads. None of that is wanted when the server runs inside a plugin process whose stdout is
+ * already captured by the Nukkit side of the bridge, so this keeps to STDOUT and stays PSR-3
+ * shaped via PM's own AttachableThreadSafeLogger base.
+ */
+
+declare(strict_types=1);
+
+namespace pocketmine\mukkit;
+
+use pocketmine\thread\log\AttachableThreadSafeLogger;
+
+final class HeadlessLogger extends AttachableThreadSafeLogger{
+
+	private bool $debugEnabled;
+
+	/**
+	 * Not a property on purpose: this class is a `ThreadSafe`, and pmmpthread refuses to store a
+	 * closure (bound to a non-thread-safe `$this`, such as the host runtime) inside one - "Closures
+	 * with non-thread-safe $this cannot be made thread-safe". A static keeps the sink out of the
+	 * thread-safe object entirely; worker threads get their own copy (null) and fall back to
+	 * STDOUT, which is where the JVM reads host logs anyway.
+	 *
+	 * @var (\Closure(string, string): void)|null
+	 */
+	private static ?\Closure $sink = null;
+
+	public function __construct(bool $debugEnabled = false){
+		parent::__construct();
+		$this->debugEnabled = $debugEnabled;
+	}
+
+	/**
+	 * Redirects log lines away from STDOUT, so a host can turn them into bridge ops instead of
+	 * letting plugin output escape into its own console stream.
+	 *
+	 * @param (\Closure(string, string): void)|null $sink receives (level, message)
+	 */
+	public function setSink(?\Closure $sink) : void{
+		self::$sink = $sink;
+	}
+
+	public function emergency($message) : void{ $this->write("EMERGENCY", $message); }
+	public function alert($message) : void{ $this->write("ALERT", $message); }
+	public function critical($message) : void{ $this->write("CRITICAL", $message); }
+	public function error($message) : void{ $this->write("ERROR", $message); }
+	public function warning($message) : void{ $this->write("WARNING", $message); }
+	public function notice($message) : void{ $this->write("NOTICE", $message); }
+	public function info($message) : void{ $this->write("INFO", $message); }
+
+	public function debug($message) : void{
+		if($this->debugEnabled){
+			$this->write("DEBUG", $message);
+		}
+	}
+
+	public function log($level, $message) : void{
+		$this->write(strtoupper((string) $level), $message);
+	}
+
+	public function logException(\Throwable $e, $trace = null) : void{
+		$this->write("ERROR", $e::class . ": " . $e->getMessage() . " @ " . $e->getFile() . ":" . $e->getLine());
+		$trace ??= $e->getTrace();
+		foreach($trace as $frame){
+			$where = ($frame["file"] ?? "?") . ":" . ($frame["line"] ?? "?");
+			$call = ($frame["class"] ?? "") . ($frame["type"] ?? "") . ($frame["function"] ?? "");
+			$this->write("ERROR", "  at " . $call . " (" . $where . ")");
+		}
+	}
+
+	private function write(string $level, $message) : void{
+		$text = $message instanceof \Stringable || is_scalar($message) ? (string) $message : get_debug_type($message);
+		if(self::$sink !== null){
+			(self::$sink)($level, $text);
+			return;
+		}
+		fwrite(STDOUT, "[mukkit-host][" . $level . "] " . $text . PHP_EOL);
+	}
+}
diff --git a/src/mukkit/HeadlessServer.php b/src/mukkit/HeadlessServer.php
new file mode 100644
index 000000000..249cdde4b
--- /dev/null
+++ b/src/mukkit/HeadlessServer.php
@@ -0,0 +1,98 @@
+<?php
+
+/*
+ * Mukkit: a Server that boots and then gives control back.
+ *
+ * The whole point of the fork is captured by these three overrides: no main loop, no UDP sockets,
+ * no world loaded from disk. Everything else - plugin manager, scheduler, event bus, command map,
+ * config, item registry - is upstream PocketMine running unmodified.
+ *
+ * What a caller gets back from the constructor is a fully booted server that does nothing until
+ * tick() is called. See pm-host/bin/pm-boot.php for the driving side.
+ */
+
+declare(strict_types=1);
+
+namespace pocketmine\mukkit;
+
+use pocketmine\scheduler\AsyncPool;
+use pocketmine\Server;
+use pocketmine\snooze\SleeperHandler;
+use pocketmine\thread\log\AttachableThreadSafeLogger;
+use pocketmine\thread\ThreadSafeClassLoader;
+use pocketmine\world\World;
+
+final class HeadlessServer extends Server{
+
+	private bool $bootComplete = false;
+
+	public function __construct(
+		ThreadSafeClassLoader $loader,
+		AttachableThreadSafeLogger $logger,
+		string $dataPath,
+		string $pluginPath,
+		private readonly ?string $defaultWorld = null
+	){
+		parent::__construct($loader, $logger, $dataPath, $pluginPath);
+	}
+
+	/**
+	 * Cut #7: the pool depends on what the interpreter can do.
+	 *
+	 * On stock PHP there are no threads, so AsyncTasks run inline (see SyncAsyncPool for what that
+	 * costs). On a PHP that carries pmmpthread - the official pmmp binaries do - the real pool is
+	 * correct and strictly better: parallel execution, working publishProgress, timings. The
+	 * decision is made once, here, instead of asking every caller to care.
+	 */
+	protected function createAsyncPool(int $size, int $memoryLimit, ThreadSafeClassLoader $classLoader, AttachableThreadSafeLogger $logger, SleeperHandler $eventLoop) : AsyncPool{
+		if(extension_loaded("pmmpthread")){
+			$logger->info("async pool: pmmpthread worker threads (" . $size . ")");
+			return parent::createAsyncPool($size, $memoryLimit, $classLoader, $logger, $eventLoop);
+		}
+		$logger->info("async pool: inline on the tick thread (no pmmpthread extension)");
+		return new SyncAsyncPool($size, $memoryLimit, $classLoader, $logger, $eventLoop);
+	}
+
+	/**
+	 * Cut #1/#3: the constructor returns here instead of blocking in tickProcessor().
+	 */
+	protected function enterMainLoop() : void{
+		$this->bootComplete = true;
+	}
+
+	/**
+	 * Cut #5: no default world. The world is Nukkit's; PM only ever sees a read-only mirror
+	 * pushed over the bridge (M5), so loading one from dataPath would be both wrong and slow.
+	 *
+	 * The one exception is the world Nukkit calls its default level. Plugins enable at POSTWORLD
+	 * (right after this hook) and many of them ask the world manager for it in `onEnable`, so it
+	 * is built and registered here - before any player can join, and before plugins can look.
+	 */
+	protected function startupPrepareWorlds() : bool{
+		$name = $this->defaultWorld;
+		if($name !== null && $name !== ""){
+			$world = new World(
+				$this,
+				$name,
+				new BridgeWorldProvider($this->getDataPath() . "worlds/" . $name, new BridgeWorldData($name)),
+				$this->getAsyncPool()
+			);
+			$this->getWorldManager()->registerWorld($world);
+			$this->getWorldManager()->setDefaultWorld($world);
+		}
+		return true;
+	}
+
+	/**
+	 * Cut #4: no RakLibInterface, so no UDP bind. $this->network still exists (it is created
+	 * earlier in the constructor) and ticking it with zero interfaces is a no-op, which keeps
+	 * Server::tick() honest instead of branching on "headless" in twenty places.
+	 */
+	protected function startupPrepareNetworkInterfaces() : bool{
+		return true;
+	}
+
+	public function isBootComplete() : bool{
+		return $this->bootComplete;
+	}
+}
diff --git a/src/mukkit/SyncAsyncPool.php b/src/mukkit/SyncAsyncPool.php
new file mode 100644
index 000000000..2130eb3e3
--- /dev/null
+++ b/src/mukkit/SyncAsyncPool.php
@@ -0,0 +1,144 @@
+<?php
+
+/*
+ * Mukkit: a synchronous stand-in for PocketMine's AsyncPool.
+ *
+ * Upstream runs AsyncTasks on a pool of pmmpthread workers. A headless host has no threads at all
+ * (see src/mukkit/polyfill/thread.php), so this pool runs each task's body inline on the caller's
+ * thread and defers onCompletion() to the next collectTasks(), which is exactly the tick boundary
+ * Server::tick() already calls it at.
+ *
+ * Honest about the trade-off, because it is observable:
+ *   - A task that would have taken 50ms still takes 50ms here - but it now costs 50ms of tick
+ *     time instead of overlapping with the game loop. Plugins that do heavy work in AsyncTask
+ *     will visibly drop TPS. That is a downgrade, not a bug; it must be probed at load time,
+ *     not hidden (docs/pm-fork-plan.md, "同步 AsyncPool 的语义漂移").
+ *   - Timings for async tasks are not recorded (no worker scope to attribute them to).
+ *   - publishProgress()/onProgressUpdate() are no-ops: onRun() has already returned by then.
+ */
+
+declare(strict_types=1);
+
+namespace pocketmine\mukkit;
+
+use pocketmine\scheduler\AsyncPool;
+use pocketmine\scheduler\AsyncTask;
+
+final class SyncAsyncPool extends AsyncPool{
+
+	/** @var list<\Closure> */
+	private array $startHooks = [];
+
+	/** @var list<AsyncTask> */
+	private array $completed = [];
+
+	private int $nextWorker = 0;
+	private bool $closed = false;
+
+	public function getSize() : int{
+		return $this->size;
+	}
+
+	public function increaseSize(int $newSize) : void{
+		if($newSize > $this->size){
+			$this->size = $newSize;
+		}
+	}
+
+	public function addWorkerStartHook(\Closure $hook) : void{
+		$this->startHooks[] = $hook;
+	}
+
+	public function removeWorkerStartHook(\Closure $hook) : void{
+		foreach($this->startHooks as $i => $existing){
+			if($existing === $hook){
+				unset($this->startHooks[$i]);
+			}
+		}
+		$this->startHooks = array_values($this->startHooks);
+	}
+
+	public function getRunningWorkers() : array{
+		return [];
+	}
+
+	public function selectWorker() : int{
+		$size = max(1, $this->size);
+		$worker = $this->nextWorker % $size;
+		$this->nextWorker = ($worker + 1) % $size;
+		return $worker;
+	}
+
+	public function submitTask(AsyncTask $task) : int{
+		$worker = $this->selectWorker();
+		$this->submitTaskToWorker($task, $worker);
+		return $worker;
+	}
+
+	public function submitTaskToWorker(AsyncTask $task, int $worker) : void{
+		if($worker < 0 || $worker >= max(1, $this->size)){
+			throw new \InvalidArgumentException("Invalid worker $worker");
+		}
+		if($task->isSubmitted()){
+			throw new \InvalidArgumentException("Cannot submit the same AsyncTask instance more than once");
+		}
+		if($this->closed){
+			throw new \RuntimeException("Cannot submit tasks to a shut down pool");
+		}
+
+		$task->setSubmitted();
+
+		try{
+			$task->onRun();
+		}catch(\Throwable $e){
+			$logger = \GlobalLogger::get();
+			$logger->error("Async task " . $task::class . " failed: " . $e->getMessage());
+			$task->onError();
+		}
+		$task->markFinishedForSyncPool();
+
+		$this->completed[] = $task;
+
+		if($worker >= count($this->startHooks)){
+			foreach($this->startHooks as $hook){
+				$hook($worker);
+			}
+		}
+	}
+
+	public function collectTasks() : bool{
+		if($this->completed === []){
+			return false;
+		}
+
+		$pending = $this->completed;
+		$this->completed = [];
+		foreach($pending as $task){
+			try{
+				$task->onCompletion();
+			}catch(\Throwable $e){
+				\GlobalLogger::get()->error("Async task " . $task::class . " onCompletion failed: " . $e->getMessage());
+			}
+		}
+
+		return $this->completed !== [];
+	}
+
+	public function collectTasksFromWorker(int $worker) : bool{
+		return $this->collectTasks();
+	}
+
+	public function getTaskQueueSizes() : array{
+		return array_fill(0, max(1, $this->size), 0);
+	}
+
+	public function shutdownUnusedWorkers() : int{
+		return 0;
+	}
+
+	public function shutdown() : void{
+		$this->closed = true;
+		$this->collectTasks();
+		$this->startHooks = [];
+	}
+}
diff --git a/src/mukkit/Yaml.php b/src/mukkit/Yaml.php
new file mode 100644
index 000000000..cbc3369ce
--- /dev/null
+++ b/src/mukkit/Yaml.php
@@ -0,0 +1,390 @@
+<?php
+
+/*
+ * Mukkit: userland YAML for the headless fork.
+ *
+ * PocketMine uses the ext-yaml C extension in exactly three places: the server config, plugin.yml
+ * and the IP graylist. Installing that extension means rebuilding PHP, so the fork boots with this
+ * parser instead (see docs/pm-fork-plan.md, "摘依赖").
+ *
+ * Scope is deliberately "PocketMine-compatible", not "YAML 1.2 complete":
+ *   - block maps and block sequences, nested by indentation
+ *   - inline sequences ([a, b]) and quoted scalars
+ *   - booleans, null, ints, floats
+ *   - comments, blank lines, --- / ... markers
+ * Not supported: anchors, aliases, tags, multi-line block scalars (| and >), flow mappings
+ * ({a: b}). PM's own resources use none of them; the probe in pm-host/bin/pm-boot.php parses
+ * every YAML file shipped by the fork to prove that.
+ */
+
+declare(strict_types=1);
+
+namespace pocketmine\mukkit;
+
+use function array_pop;
+use function count;
+use function ctype_digit;
+use function in_array;
+use function is_array;
+use function is_bool;
+use function is_float;
+use function is_int;
+use function is_string;
+use function ltrim;
+use function preg_match;
+use function rtrim;
+use function str_contains;
+use function str_starts_with;
+use function strtolower;
+use function substr;
+use function trim;
+
+final class Yaml{
+
+	/**
+	 * @return mixed parsed document, or null when the document is empty
+	 */
+	public static function parse(string $yaml) : mixed{
+		$lines = self::tokenize($yaml);
+		if($lines === []){
+			return null;
+		}
+		$index = 0;
+		$value = self::parseNode($lines, $index, $lines[0]["indent"]);
+		return $value;
+	}
+
+	/**
+	 * @param list<array{indent: int, text: string}> $lines
+	 */
+	private static function parseNode(array $lines, int &$i, int $indent) : mixed{
+		if($i >= count($lines)){
+			return null;
+		}
+		return self::isSequenceItem($lines[$i]["text"]) ? self::parseSequence($lines, $i, $indent) : self::parseMapping($lines, $i, $indent);
+	}
+
+	/**
+	 * @param list<array{indent: int, text: string}> $lines
+	 * @return array<string, mixed>
+	 */
+	private static function parseMapping(array $lines, int &$i, int $indent) : array{
+		$result = [];
+		$total = count($lines);
+
+		while($i < $total){
+			$line = $lines[$i];
+			if($line["indent"] < $indent){
+				break;
+			}
+			if($line["indent"] > $indent){
+				//Stray deeper line: the caller already consumed its parent, skip rather than guess.
+				$i++;
+				continue;
+			}
+			if(self::isSequenceItem($line["text"])){
+				break;
+			}
+
+			$split = self::splitKeyValue($line["text"]);
+			if($split === null){
+				//A bare scalar inside a mapping is a malformed document; ignore the line.
+				$i++;
+				continue;
+			}
+			[$key, $rawValue] = $split;
+
+			if($rawValue === ""){
+				$i++;
+				//A sequence may sit at the *same* indent as its key:
+				//    api:
+				//    - 5.0.0
+				//That is what most real plugin.yml files do, and treating it as "empty value"
+				//drops the sequence and every key after it - which is how a valid plugin ends
+				//up with an empty API list.
+				if($i < $total && $lines[$i]["indent"] === $indent && self::isSequenceItem($lines[$i]["text"])){
+					$result[$key] = self::parseSequence($lines, $i, $indent);
+				}elseif($i < $total && $lines[$i]["indent"] > $indent){
+					$result[$key] = self::parseNode($lines, $i, $lines[$i]["indent"]);
+				}else{
+					$result[$key] = null;
+				}
+				continue;
+			}
+
+			$i++;
+			$result[$key] = self::scalar($rawValue);
+		}
+
+		return $result;
+	}
+
+	/**
+	 * @param list<array{indent: int, text: string}> $lines
+	 * @return list<mixed>
+	 */
+	private static function parseSequence(array $lines, int &$i, int $indent) : array{
+		$result = [];
+		$total = count($lines);
+
+		while($i < $total){
+			$line = $lines[$i];
+			if($line["indent"] !== $indent || !self::isSequenceItem($line["text"])){
+				break;
+			}
+
+			$rest = ltrim(substr($line["text"], 1));
+			if($rest === ""){
+				$i++;
+				if($i < $total && $lines[$i]["indent"] > $indent){
+					$result[] = self::parseNode($lines, $i, $lines[$i]["indent"]);
+				}else{
+					$result[] = null;
+				}
+				continue;
+			}
+
+			//"- key: value" starts a mapping whose keys live at the item's content column.
+			if(self::splitKeyValue($rest) !== null && !str_starts_with($rest, "[") && !str_starts_with($rest, "\"") && !str_starts_with($rest, "'")){
+				$lines[$i] = ["indent" => $indent + 2, "text" => $rest];
+				$result[] = self::parseMapping($lines, $i, $indent + 2);
+				continue;
+			}
+
+			$result[] = self::scalar($rest);
+			$i++;
+		}
+
+		return $result;
+	}
+
+	private static function isSequenceItem(string $text) : bool{
+		return $text === "-" || str_starts_with($text, "- ");
+	}
+
+	/**
+	 * @return array{0: string, 1: string}|null [key, raw value]
+	 */
+	private static function splitKeyValue(string $text) : ?array{
+		$length = strlen($text);
+		$quote = null;
+
+		for($k = 0; $k < $length; $k++){
+			$char = $text[$k];
+			if($quote !== null){
+				if($char === $quote){
+					$quote = null;
+				}
+				continue;
+			}
+			if($char === "\"" || $char === "'"){
+				$quote = $char;
+				continue;
+			}
+			if($char === ":"){
+				$next = $k + 1 < $length ? $text[$k + 1] : " ";
+				if($next === " " || $k + 1 === $length){
+					$key = trim(substr($text, 0, $k));
+					$value = trim(substr($text, $k + 1));
+					return [self::unquote($key), $value];
+				}
+			}
+		}
+
+		return null;
+	}
+
+	private static function scalar(string $raw) : mixed{
+		$raw = trim($raw);
+		if($raw === ""){
+			return null;
+		}
+
+		if(str_starts_with($raw, "[") && str_ends_with($raw, "]")){
+			$inner = trim(substr($raw, 1, -1));
+			if($inner === ""){
+				return [];
+			}
+			$items = [];
+			$buffer = "";
+			$quote = null;
+			$length = strlen($inner);
+			for($k = 0; $k < $length; $k++){
+				$char = $inner[$k];
+				if($quote !== null){
+					$buffer .= $char;
+					if($char === $quote){
+						$quote = null;
+					}
+					continue;
+				}
+				if($char === "\"" || $char === "'"){
+					$quote = $char;
+					$buffer .= $char;
+					continue;
+				}
+				if($char === ","){
+					$items[] = self::scalar($buffer);
+					$buffer = "";
+					continue;
+				}
+				$buffer .= $char;
+			}
+			$items[] = self::scalar($buffer);
+			return $items;
+		}
+
+		if($raw[0] === "\"" || $raw[0] === "'"){
+			return self::unquote($raw);
+		}
+
+		$lower = strtolower($raw);
+		if(in_array($lower, ["true", "yes", "on"], true)){
+			return true;
+		}
+		if(in_array($lower, ["false", "no", "off"], true)){
+			return false;
+		}
+		if(in_array($lower, ["null", "~"], true)){
+			return null;
+		}
+		if(preg_match('/^-?\d+$/', $raw) === 1){
+			return (int) $raw;
+		}
+		if(preg_match('/^-?\d*\.\d+$/', $raw) === 1){
+			return (float) $raw;
+		}
+
+		return $raw;
+	}
+
+	private static function unquote(string $value) : string{
+		if($value === ""){
+			return $value;
+		}
+		if($value[0] === "\"" && str_ends_with($value, "\"") && strlen($value) >= 2){
+			return stripcslashes(substr($value, 1, -1));
+		}
+		if($value[0] === "'" && str_ends_with($value, "'") && strlen($value) >= 2){
+			return str_replace("''", "'", substr($value, 1, -1));
+		}
+		return $value;
+	}
+
+	/**
+	 * @return list<array{indent: int, text: string}>
+	 */
+	private static function tokenize(string $yaml) : array{
+		$yaml = str_replace(["\r\n", "\r"], "\n", $yaml);
+		if(str_starts_with($yaml, "\xEF\xBB\xBF")){
+			$yaml = substr($yaml, 3);
+		}
+
+		$lines = [];
+		foreach(explode("\n", $yaml) as $raw){
+			if(str_contains($raw, "\t")){
+				//Tabs are illegal for indentation in YAML; PM never emits them.
+				$raw = str_replace("\t", "  ", $raw);
+			}
+			$text = rtrim($raw);
+			$text = self::stripComment($text);
+			$text = rtrim($text);
+			if($text === "" || $text === "---" || $text === "..."){
+				continue;
+			}
+
+			$indent = 0;
+			$length = strlen($text);
+			while($indent < $length && $text[$indent] === " "){
+				$indent++;
+			}
+			$lines[] = ["indent" => $indent, "text" => substr($text, $indent)];
+		}
+
+		return $lines;
+	}
+
+	private static function stripComment(string $line) : string{
+		$length = strlen($line);
+		$quote = null;
+		for($k = 0; $k < $length; $k++){
+			$char = $line[$k];
+			if($quote !== null){
+				if($char === $quote){
+					$quote = null;
+				}
+				continue;
+			}
+			if($char === "\"" || $char === "'"){
+				$quote = $char;
+				continue;
+			}
+			if($char === "#" && ($k === 0 || $line[$k - 1] === " ")){
+				return substr($line, 0, $k);
+			}
+		}
+		return $line;
+	}
+
+	/**
+	 * Emits a document ext-yaml's yaml_emit() could have produced for the same data.
+	 */
+	public static function emit(mixed $data) : string{
+		return self::emitNode($data, 0) . "\n";
+	}
+
+	private static function emitNode(mixed $data, int $depth) : string{
+		$pad = str_repeat("  ", $depth);
+
+		if(is_array($data)){
+			if($data === []){
+				return "[]";
+			}
+			$isList = array_keys($data) === range(0, count($data) - 1);
+			$out = [];
+			foreach($data as $key => $value){
+				if($isList){
+					if(is_array($value) && $value !== []){
+						$out[] = $pad . "-" . "\n" . self::emitNode($value, $depth + 1);
+					}elseif(is_array($value)){
+						$out[] = $pad . "- []";
+					}else{
+						$out[] = $pad . "- " . self::emitScalar($value);
+					}
+					continue;
+				}
+				$emittedKey = self::emitScalar((string) $key);
+				if(is_array($value) && $value !== []){
+					$out[] = $pad . $emittedKey . ":" . "\n" . self::emitNode($value, $depth + 1);
+				}elseif(is_array($value)){
+					//Empty containers stay on the key's line: "money:\n  []" re-parses as null.
+					$out[] = $pad . $emittedKey . ": []";
+				}else{
+					$out[] = $pad . $emittedKey . ": " . self::emitScalar($value);
+				}
+			}
+			return implode("\n", $out);
+		}
+
+		return $pad . self::emitScalar($data);
+	}
+
+	private static function emitScalar(mixed $value) : string{
+		if($value === null){
+			return "null";
+		}
+		if(is_bool($value)){
+			return $value ? "true" : "false";
+		}
+		if(is_int($value) || is_float($value)){
+			return (string) $value;
+		}
+		if(is_string($value)){
+			if($value === "" || preg_match('/^[A-Za-z0-9_.\/\\-]+$/', $value) !== 1 || in_array(strtolower($value), ["true", "false", "null", "yes", "no", "on", "off", "~"], true) || ctype_digit($value)){
+				return "\"" . addcslashes($value, "\"\\\n") . "\"";
+			}
+			return $value;
+		}
+		return "\"" . addcslashes((string) $value, "\"\\\n") . "\"";
+	}
+}
diff --git a/src/mukkit/polyfill.php b/src/mukkit/polyfill.php
new file mode 100644
index 000000000..e919bd10d
--- /dev/null
+++ b/src/mukkit/polyfill.php
@@ -0,0 +1,39 @@
+<?php
+
+/*
+ * Mukkit: one include that makes PocketMine bootable on stock PHP.
+ *
+ * Order matters: pmmp\thread classes must exist before PM's src/thread/* hierarchy is autoloaded,
+ * and the yaml function shims must exist before Server's constructor touches its config.
+ *
+ * Usage (pm-host/bin/pm-boot.php does exactly this):
+ *   require "src/mukkit/polyfill.php";
+ *   require "vendor/autoload.php";
+ */
+
+declare(strict_types=1);
+
+/*
+ * A headless host is a child process: when it crashes, the parent decides whether to restart.
+ * Upstream sleeps 120 s before exiting to throttle crash loops, which from the outside is
+ * indistinguishable from a hang - and the bridge's tick loop is blocked the whole time.
+ */
+define("MUKKIT_NO_RESTART_THROTTLE", true);
+
+//On stock PHP these shims are the whole point. On a PHP built for PocketMine (the official
+//pmmp PHP binaries) the real extensions are loaded, and redefining their classes or functions is
+//a fatal error - so ask the runtime which world it is in, extension by extension. A box with
+//pmmpthread but without chunkutils2 is possible and must still boot.
+foreach([
+	"pmmpthread" => "thread",
+	"chunkutils2" => "chunkutils2",
+	"encoding" => "encoding",
+	"morton" => "morton",
+] as $extension => $shim){
+	if(!extension_loaded($extension)){
+		require_once __DIR__ . "/polyfill/" . $shim . ".php";
+	}
+}
+//These two are guarded internally (`function_exists`), so they are safe either way.
+require_once __DIR__ . "/polyfill/ext-stubs.php";
+require_once __DIR__ . "/polyfill/yaml.php";
diff --git a/src/mukkit/polyfill/chunkutils2.php b/src/mukkit/polyfill/chunkutils2.php
new file mode 100644
index 000000000..065c4c256
--- /dev/null
+++ b/src/mukkit/polyfill/chunkutils2.php
@@ -0,0 +1,243 @@
+<?php
+
+declare(strict_types=1);
+
+/**
+ * Userland stand-ins for the two classes ext-chunkutils2 provides in PocketMine's own namespace.
+ *
+ * These are NOT protocol-level shims - they are the block storage `Chunk` and `SubChunk` are
+ * built on, so without them the fork cannot construct a single chunk, and world mirroring (M5)
+ * cannot exist at all.
+ *
+ * ## The one rule for this file
+ *
+ * **Never add a member the extension does not have.** This file is skipped whenever
+ * `extension_loaded("chunkutils2")` is true (see `src/mukkit/polyfill.php`), and the product
+ * ships the pmmp PHP, which has the extension. So anything only this file provides exists on a
+ * dev box and does not exist in production. That is not hypothetical: `SIZE`,
+ * `getPackedData()` and `fromPackedData()` were invented here, the mirror used them, every dev
+ * run passed, and on the real PHP the first block a player broke wedged the bridge with
+ * `Undefined constant pocketmine\world\format\PalettedBlockArray::SIZE` on every tick.
+ * `pm-host/tests/pm-chunkutils2-parity-test.php` now fails if the rule is broken again.
+ *
+ * Members here are a subset of ext-chunkutils2 0.3.5, the version in the bundled pmmp PHP -
+ *   PalettedBlockArray: __construct, get, set, getBitsPerBlock, getWordArray, getPalette,
+ *                       collectGarbage
+ *   LightArray:         __construct, fill, get, set, getData, collectGarbage, isUniform
+ * (measured with ReflectionClass on that binary, not guessed from the docs.)
+ *
+ * The extension has more (`fromData`, `getExpectedWordArraySize`, `getMaxPaletteSize`,
+ * `replaceAll`) and this file does not. That direction is safe: a disk or network path fails
+ * loudly on a dev box instead of encoding something subtly different.
+ *
+ * Design note: layout is bit-compatible with the extension's *documented* semantics (index
+ * order, 4-bit light), but the block storage is deliberately simple - a uniform value, or a
+ * packed little-endian string. A real palette would save memory on disk-bound worlds; the
+ * bridge never writes these to disk and never serialises them through the network path, so the
+ * packed form is enough and keeps `get()` cheap. `getBitsPerBlock()` therefore reports 32 for a
+ * non-uniform section - a value the extension never returns - which is exactly the kind of thing
+ * that must not leak out of this file.
+ */
+
+namespace pocketmine\world\format;
+
+if(!class_exists(PalettedBlockArray::class, false)){
+
+	/**
+	 * 4096 block/biome entries addressed by (x, y, z) with X varying fastest, then Z, then Y.
+	 *
+	 * Entry width is 32 bits, not 16: PocketMine 5 packs the block type and its state data into a
+	 * single int (`Block::getStateId()`, e.g. air is 20481500), so a 16-bit palette index would
+	 * silently truncate every state above 65535. The real extension stores palette indices and
+	 * keeps the palette alongside; this build stores the state IDs directly because nothing here
+	 * ever serialises a chunk to disk or to the network.
+	 *
+	 * Two states:
+	 *  - uniform: `$data === null`, every entry reads as `$fill` (an all-air subchunk costs one int)
+	 *  - packed:  `$data` is 4096 little-endian uint32s
+	 *
+	 * Materialising is deferred until the first write that differs from the fill value, which is
+	 * what keeps a 24-subchunk chunk affordable in plain PHP.
+	 */
+	final class PalettedBlockArray{
+
+		/** 16^3. Private on purpose: the extension has no SIZE constant to shadow. */
+		private const VOLUME = 4096;
+
+		private int $fill;
+		/** @var string|null 4096 x uint32 little-endian */
+		private ?string $data = null;
+
+		public function __construct(int $fill){
+			$this->fill = $fill;
+		}
+
+		/**
+		 * XZY order: x + (z << 4) + (y << 8).
+		 */
+		private static function idx(int $x, int $y, int $z) : int{
+			if($x < 0 || $x > 15 || $y < 0 || $y > 15 || $z < 0 || $z > 15){
+				throw new \InvalidArgumentException("Coordinates out of range: $x, $y, $z");
+			}
+			return $x | ($z << 4) | ($y << 8);
+		}
+
+		public function get(int $x, int $y, int $z) : int{
+			if($this->data === null){
+				return $this->fill;
+			}
+			return unpack("V", $this->data, self::idx($x, $y, $z) << 2)[1];
+		}
+
+		public function set(int $x, int $y, int $z, int $value) : void{
+			$i = self::idx($x, $y, $z);
+			if($this->data === null){
+				if($value === $this->fill){
+					return;
+				}
+				$this->data = str_repeat(pack("V", $this->fill), self::VOLUME);
+			}
+			$offset = $i << 2;
+			$this->data[$offset] = chr($value & 0xff);
+			$this->data[$offset + 1] = chr(($value >> 8) & 0xff);
+			$this->data[$offset + 2] = chr(($value >> 16) & 0xff);
+			$this->data[$offset + 3] = chr(($value >> 24) & 0xff);
+		}
+
+		/**
+		 * 0 means "one entry for the whole section", exactly as the extension reports it. The
+		 * mirror relies on this to answer an all-air section with a single `get()`, and
+		 * `SubChunk`'s garbage collector relies on it to drop empty layers.
+		 */
+		public function getBitsPerBlock() : int{
+			return $this->data === null ? 0 : 32;
+		}
+
+		/**
+		 * The extension hands back packed palette indices, which the serialisers use for disk and
+		 * network writes - writes this build never performs, so the packed state IDs stand in.
+		 * The uniform case is empty, matching `getExpectedWordArraySize(0) === 0`.
+		 */
+		public function getWordArray() : string{
+			return $this->data ?? "";
+		}
+
+		/**
+		 * @return int[]
+		 */
+		public function getPalette() : array{
+			if($this->data === null){
+				return [$this->fill];
+			}
+			//array_flip stays in C; a PHP loop over 4096 entries here shows up in chunk load time.
+			return array_keys(array_flip(unpack("V*", $this->data)));
+		}
+
+		/**
+		 * Collapses back to the uniform representation when it is safe to do so. Called by
+		 * `SubChunk::collectGarbage()`; never required for correctness.
+		 */
+		public function collectGarbage() : void{
+			if($this->data === null){
+				return;
+			}
+			$values = unpack("V*", $this->data);
+			$first = $values[1];
+			if(count(array_unique($values, SORT_NUMERIC)) === 1){
+				$this->fill = $first;
+				$this->data = null;
+			}
+		}
+	}
+}
+
+if(!class_exists(LightArray::class, false)){
+
+	/**
+	 * 4096 four-bit light levels, same index order as the block arrays.
+	 *
+	 * `SubChunk` allocates one lazily on the first `getBlockLightArray()` call, which happens as
+	 * soon as anything touches lighting - i.e. every `World::setBlock()` with updates on. Values
+	 * here are only ever read back by `World::getBlockLightAt()`; Nukkit owns real lighting.
+	 */
+	final class LightArray{
+
+		private const VOLUME = 4096;
+
+		private int $fill;
+		private ?string $data = null;
+
+		public function __construct(string $payload){
+			if(strlen($payload) !== self::VOLUME >> 1){
+				throw new \InvalidArgumentException("Expected " . (self::VOLUME >> 1) . " bytes, got " . strlen($payload));
+			}
+			$this->fill = 0;
+			$this->data = $payload;
+		}
+
+		public static function fill(int $level) : self{
+			$array = new self(str_repeat("\x00", self::VOLUME >> 1));
+			$array->fill = $level & 0x0f;
+			$array->data = null;
+			return $array;
+		}
+
+		private static function idx(int $x, int $y, int $z) : int{
+			if($x < 0 || $x > 15 || $y < 0 || $y > 15 || $z < 0 || $z > 15){
+				throw new \InvalidArgumentException("Coordinates out of range: $x, $y, $z");
+			}
+			return $x | ($z << 4) | ($y << 8);
+		}
+
+		public function get(int $x, int $y, int $z) : int{
+			$i = self::idx($x, $y, $z);
+			if($this->data === null){
+				return $this->fill;
+			}
+			$byte = ord($this->data[$i >> 1]);
+			return ($i & 1) === 0 ? ($byte & 0x0f) : (($byte >> 4) & 0x0f);
+		}
+
+		public function set(int $x, int $y, int $z, int $level) : void{
+			$i = self::idx($x, $y, $z);
+			if($this->data === null){
+				if(($level & 0x0f) === $this->fill){
+					return;
+				}
+				$this->data = str_repeat(chr(($this->fill << 4) | $this->fill), self::VOLUME >> 1);
+			}
+			$offset = $i >> 1;
+			$byte = ord($this->data[$offset]);
+			$byte = ($i & 1) === 0
+				? ($byte & 0xf0) | ($level & 0x0f)
+				: ($byte & 0x0f) | (($level & 0x0f) << 4);
+			$this->data[$offset] = chr($byte);
+		}
+
+		/**
+		 * 2048 bytes, two entries per byte, low nibble first.
+		 */
+		public function getData() : string{
+			return $this->data ?? str_repeat(chr(($this->fill << 4) | $this->fill), self::VOLUME >> 1);
+		}
+
+		public function collectGarbage() : void{
+			if($this->data === null){
+				return;
+			}
+			$level = ord($this->data[0]) & 0x0f;
+			if($this->isUniform($level)){
+				$this->fill = $level;
+				$this->data = null;
+			}
+		}
+
+		public function isUniform(int $level) : bool{
+			if($this->data === null){
+				return $this->fill === ($level & 0x0f);
+			}
+			$level &= 0x0f;
+			return $this->data === str_repeat(chr(($level << 4) | $level), self::VOLUME >> 1);
+		}
+	}
+}
diff --git a/src/mukkit/polyfill/encoding.php b/src/mukkit/polyfill/encoding.php
new file mode 100644
index 000000000..e2c4f7626
--- /dev/null
+++ b/src/mukkit/polyfill/encoding.php
@@ -0,0 +1,558 @@
+<?php
+
+/*
+ * Mukkit: userland pmmp/ext-encoding.
+ *
+ * Why this exists: encoding is on the *boot* path, twice over -
+ *   - Block::computeStateIdXorMask() hashes IDs with LE::packSignedLong()/BE::unpackSignedLong()
+ *   - CraftingManager::hashOutput() builds recipe keys with a ByteBufferWriter
+ * Without it the server cannot construct VanillaBlocks or load recipes, long before a packet is
+ * ever encoded.
+ *
+ * Fidelity note: this is a faithful implementation of the parts PocketMine actually exercises
+ * (integers, VarInt/zigzag, strings, byte arrays, bools). It is not byte-for-byte audited against
+ * the C extension for float edge cases or UUID helpers. That is acceptable here because the
+ * headless host never serialises network packets - packets are intercepted as objects on the
+ * Nukkit side (see docs/protocol.md) - so nothing on the wire depends on these bytes. Item and
+ * block-state round trips inside one process are self-consistent.
+ */
+
+declare(strict_types=1);
+
+namespace pmmp\encoding {
+
+	class DataDecodeException extends \RuntimeException{
+	}
+
+	final class ByteBufferWriter{
+		private string $buffer = "";
+
+		public function writeRaw(string $bytes) : void{
+			$this->buffer .= $bytes;
+		}
+
+		public function getData() : string{
+			return $this->buffer;
+		}
+
+		public function getDataLength() : int{
+			return strlen($this->buffer);
+		}
+
+		public function reset() : void{
+			$this->buffer = "";
+		}
+
+		public function writeByte(int $value) : void{
+			$this->buffer .= chr($value & 0xff);
+		}
+
+		public function writeSignedByte(int $value) : void{
+			$this->buffer .= chr($value & 0xff);
+		}
+
+		public function writeUnsignedByte(int $value) : void{
+			$this->buffer .= chr($value & 0xff);
+		}
+
+		public function writeShort(int $value) : void{
+			$this->buffer .= pack("n", $value & 0xffff);
+		}
+
+		public function writeSignedShort(int $value) : void{
+			$this->buffer .= pack("n", $value & 0xffff);
+		}
+
+		public function writeUnsignedShort(int $value) : void{
+			$this->buffer .= pack("n", $value & 0xffff);
+		}
+
+		public function writeInt(int $value) : void{
+			$this->buffer .= pack("N", $value & 0xffffffff);
+		}
+
+		public function writeSignedInt(int $value) : void{
+			$this->buffer .= pack("N", $value & 0xffffffff);
+		}
+
+		public function writeUnsignedInt(int $value) : void{
+			$this->buffer .= pack("N", $value & 0xffffffff);
+		}
+
+		public function writeLong(int $value) : void{
+			$this->buffer .= pack("J", $value);
+		}
+
+		public function writeUnsignedLong(int $value) : void{
+			$this->buffer .= pack("J", $value);
+		}
+
+		public function writeFloat(float $value) : void{
+			$this->buffer .= pack("G", $value);
+		}
+
+		public function writeDouble(float $value) : void{
+			$this->buffer .= pack("E", $value);
+		}
+
+		public function writeBool(bool $value) : void{
+			$this->buffer .= $value ? "\x01" : "\x00";
+		}
+
+		public function writeUnsignedVarInt(int $value) : void{
+			$value &= 0xffffffff;
+			while(true){
+				if($value < 0x80){
+					$this->buffer .= chr($value);
+					return;
+				}
+				$this->buffer .= chr(($value & 0x7f) | 0x80);
+				$value >>= 7;
+			}
+		}
+
+		public function writeVarInt(int $value) : void{
+			$this->writeUnsignedVarInt((($value << 1) ^ ($value >> 63)) & 0xffffffff);
+		}
+
+		public function writeUnsignedVarLong(int $value) : void{
+			while(true){
+				if(($value & ~0x7f) === 0){
+					$this->buffer .= chr($value);
+					return;
+				}
+				$this->buffer .= chr(($value & 0x7f) | 0x80);
+				$value = ($value >> 7) & ~(0x7f << 57);
+			}
+		}
+
+		public function writeVarLong(int $value) : void{
+			$this->writeUnsignedVarLong(($value << 1) ^ ($value >> 63));
+		}
+
+		public function writeString(string $value, ?int $maxLength = null) : void{
+			if($maxLength !== null && strlen($value) > $maxLength){
+				throw new \InvalidArgumentException("Expected at most $maxLength bytes, got " . strlen($value));
+			}
+			$this->writeUnsignedVarInt(strlen($value));
+			$this->buffer .= $value;
+		}
+
+		/**
+		 * Raw bytes, **no length prefix**: the caller already knows how long it is
+		 * (`readByteArray(VarInt::readUnsignedInt($reader))` is the usual shape).
+		 */
+		public function writeByteArray(string $value, ?int $maxLength = null) : void{
+			if($maxLength !== null && strlen($value) > $maxLength){
+				throw new \InvalidArgumentException("Expected at most $maxLength bytes, got " . strlen($value));
+			}
+			$this->buffer .= $value;
+		}
+
+		/** @param int[] $array */
+		public function writeIntArray(array $array) : void{
+			$this->writeUnsignedVarInt(count($array));
+			foreach($array as $v){
+				$this->writeInt($v);
+			}
+		}
+	}
+
