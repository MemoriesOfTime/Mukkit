diff --git a/src/mukkit/BridgeBlocks.php b/src/mukkit/BridgeBlocks.php
new file mode 100644
index 000000000..ee79c8bcb
--- /dev/null
+++ b/src/mukkit/BridgeBlocks.php
@@ -0,0 +1,111 @@
+<?php
+
+declare(strict_types=1);
+
+namespace pocketmine\mukkit;
+
+use pocketmine\block\RuntimeBlockStateRegistry;
+use pocketmine\data\bedrock\block\upgrade\LegacyBlockIdToStringIdMap;
+use pocketmine\network\mcpe\convert\TypeConverter;
+use pocketmine\world\format\io\GlobalBlockStateHandlers;
+
+/**
+ * The one place that translates between Nukkit's `id:meta` and PocketMine's internal blockstate
+ * IDs.
+ *
+ * Both sides speak different dialects for the same blocks: Nukkit keeps the pre-flattening
+ * numeric ID + 4-bit damage value, PocketMine assigns an internal state ID per state (stairs
+ * facing east with waterlogged=true is its own ID). Neither numbering can be derived from the
+ * other, so each side translates using its own table:
+ *
+ *  - inbound: id:meta -> `BlockIdMetaUpgrader` -> `BlockStateData` -> `Block` -> internal state ID
+ *  - outbound: internal state ID -> deterministic serialiser -> name + meta -> legacy numeric ID
+ *
+ * The inbound path is PocketMine's own "upgrade a PM3 world" code path, which is the only
+ * sanctioned numeric-ID table in the codebase. It is lossy in the same way the old format was:
+ * several states collapse onto one meta value. Documented, not silently accepted - the caller
+ * counts failures.
+ */
+final class BridgeBlocks{
+
+	/** @var array<int, int|null> id << 4 | meta => internal state ID */
+	private static array $toStateId = [];
+
+	/** @var array<int, array{int, int}|null> internal state ID => [id, meta] */
+	private static array $toIdMeta = [];
+
+	/** @var array<string, int>|null */
+	private static ?array $nameToLegacy = null;
+
+	public static function stateIdFromIdMeta(int $id, int $meta): ?int
+	{
+		$key = ($id << 4) | ($meta & 0x0f);
+		if (array_key_exists($key, self::$toStateId)) {
+			return self::$toStateId[$key];
+		}
+
+		try {
+			$data = GlobalBlockStateHandlers::getUpgrader()->upgradeIntIdMeta($id, $meta);
+			//`deserialize()` returns the internal state ID, not a Block.
+			$stateId = GlobalBlockStateHandlers::getDeserializer()->deserialize($data);
+		} catch (\Throwable) {
+			// Unknown legacy ID (a block newer than PM's upgrade table) - not an error in the
+			// bridge, but the caller must know it got nothing.
+			$stateId = null;
+		}
+
+		return self::$toStateId[$key] = $stateId;
+	}
+
+	/**
+	 * @return array{int, int}|null [legacy numeric id, meta]
+	 */
+	public static function idMetaFromStateId(int $stateId): ?array
+	{
+		if (array_key_exists($stateId, self::$toIdMeta)) {
+			return self::$toIdMeta[$stateId];
+		}
+
+		try {
+			$converter = TypeConverter::getInstance();
+			$translator = $converter->getBlockTranslator();
+			$networkId = $translator->internalIdToNetworkId($stateId);
+			$data = $translator->getBlockStateDictionary()->generateDataFromStateId($networkId);
+			$meta = $translator->getBlockStateDictionary()->getMetaFromStateId($networkId);
+			if ($data === null || $meta === null) {
+				return self::$toIdMeta[$stateId] = null;
+			}
+			$id = self::legacyIdFromName($data->getName());
+			if ($id === null) {
+				return self::$toIdMeta[$stateId] = null;
+			}
+		} catch (\Throwable) {
+			return self::$toIdMeta[$stateId] = null;
+		}
+
+		return self::$toIdMeta[$stateId] = [$id, $meta];
+	}
+
+	private static function legacyIdFromName(string $name): ?int
+	{
+		if (self::$nameToLegacy === null) {
+			self::$nameToLegacy = array_flip(LegacyBlockIdToStringIdMap::getInstance()->getLegacyToStringMap());
+		}
+		//The table is keyed with the namespace (`minecraft:stone`), but older entries are not,
+		//so try the name as given before falling back to the bare one.
+		return self::$nameToLegacy[$name]
+			?? self::$nameToLegacy[str_starts_with($name, 'minecraft:') ? substr($name, 10) : $name]
+			?? null;
+	}
+
+	/**
+	 * Used by the acceptance test to prove the round trip without going through a world.
+	 *
+	 * @return array{int, int}|null
+	 */
+	public static function roundTrip(int $id, int $meta): ?array
+	{
+		$stateId = self::stateIdFromIdMeta($id, $meta);
+		return $stateId === null ? null : self::idMetaFromStateId($stateId);
+	}
+}
diff --git a/src/mukkit/BridgeEffects.php b/src/mukkit/BridgeEffects.php
new file mode 100644
index 000000000..7adfedfe6
--- /dev/null
+++ b/src/mukkit/BridgeEffects.php
@@ -0,0 +1,163 @@
+<?php
+
+declare(strict_types=1);
+
+namespace pocketmine\mukkit;
+
+use pocketmine\data\bedrock\EffectIdMap;
+use pocketmine\entity\effect\EffectInstance;
+use pocketmine\entity\effect\EffectManager;
+use pocketmine\entity\Living;
+
+/**
+ * The potion-effect half of the mirror, shared by players and entities.
+ *
+ * PocketMine 5 no longer gives an effect a numeric identity: an `Effect` is a *type* object and
+ * `EffectInstance` carries the duration/amplifier. The wire, however, has always spoken Bedrock's
+ * numeric effect ids, and that is also what Nukkit uses. `EffectIdMap` is PocketMine's own bridge
+ * between the two, so the mapping is taken from upstream rather than invented here.
+ *
+ * Duration is ticks on both sides. PocketMine can mark an effect infinite; the wire has no such
+ * flag (Nukkit cannot express it either), so an infinite effect travels as `INT32_MAX` ticks,
+ * roughly three years. When it comes back it is re-created as infinite rather than as a timer
+ * that happens to be enormous.
+ *
+ * A custom effect this build has no save id for is left alone in both directions. Removing it
+ * would mean deleting something the bridge cannot name, and naming it by guess would put a
+ * different effect on the client.
+ */
+final class BridgeEffects{
+
+	/** The largest duration Nukkit's int field can hold; used for PocketMine's infinite effects. */
+	public const INFINITE_DURATION = 2_147_483_647;
+
+	/**
+	 * @return list<array{0:int,1:int,2:int,3:bool,4:bool}>
+	 */
+	public static function snapshot(EffectManager $effects) : array{
+		$rows = [];
+		foreach($effects->all() as $instance){
+			$id = self::idOf($instance);
+			if($id === null){
+				continue;
+			}
+			$rows[$id] = self::row($id, $instance);
+		}
+		//A stable order is what makes "same list" a plain array comparison in `diff()`.
+		ksort($rows);
+		return array_values($rows);
+	}
+
+	/**
+	 * @param list<array<int, mixed>> $rows
+	 *
+	 * @return list<string> reasons an effect could not be applied verbatim
+	 */
+	public static function apply(Living $entity, array $rows) : array{
+		$gaps = [];
+		$wanted = [];
+		foreach($rows as $row){
+			if(!is_array($row) || count($row) < 2){
+				$gaps[] = "malformed effect row";
+				continue;
+			}
+			$wanted[(int) $row[0]] = $row;
+		}
+
+		$current = [];
+		foreach($entity->getEffects()->all() as $instance){
+			$id = self::idOf($instance);
+			if($id !== null){
+				$current[$id] = $instance;
+			}
+		}
+
+		//Remove first: a weaker replacement is refused by upstream's `canAdd()`, and an effect
+		//that is gone must not survive because the new one happened to be weaker.
+		foreach($current as $id => $instance){
+			if(isset($wanted[$id])){
+				continue;
+			}
+			$type = $instance->getType();
+			$entity->getEffects()->remove($type);
+			if($entity->getEffects()->has($type)){
+				$gaps[] = "effect " . $id . " removal was cancelled";
+			}
+		}
+
+		foreach($wanted as $id => $row){
+			$type = EffectIdMap::getInstance()->fromId($id);
+			if($type === null){
+				$gaps[] = "unknown effect id " . $id;
+				continue;
+			}
+			//A negative duration is how some Nukkit plugins spell "forever"; it must not become
+			//zero ticks, which would make the effect expire on the next PM tick.
+			$rawDuration = (int) ($row[1] ?? 0);
+			$duration = $rawDuration < 0 ? self::INFINITE_DURATION : $rawDuration;
+			$amplifier = max(0, (int) ($row[2] ?? 0));
+			$visible = (bool) ($row[3] ?? true);
+			$ambient = (bool) ($row[4] ?? false);
+			$existing = $current[$id] ?? null;
+			if($existing !== null
+				&& $existing->getDuration() === $duration
+				&& $existing->getAmplifier() === $amplifier
+				&& $existing->isVisible() === $visible
+				&& $existing->isAmbient() === $ambient){
+				continue;
+			}
+			if($existing !== null && ($duration >= self::INFINITE_DURATION) === $existing->isInfinite()){
+				//Only the numbers moved (Nukkit's countdown is the usual cause). Updating the
+				//instance in place avoids firing add/remove events every second, and the mirror
+				//has no client to redraw - the effect icon is drawn from the values, not an event.
+				$existing->setDuration($duration);
+				$existing->setAmplifier($amplifier);
+				$existing->setVisible($visible);
+				$existing->setAmbient($ambient);
+				continue;
+			}
+			if($existing !== null){
+				$entity->getEffects()->remove($type);
+				if($entity->getEffects()->has($type)){
+					$gaps[] = "effect " . $id . " could not be replaced";
+					continue;
+				}
+			}
+			$instance = new EffectInstance(
+				$type,
+				$duration,
+				$amplifier,
+				$visible,
+				$ambient,
+				infinite: $duration >= self::INFINITE_DURATION
+			);
+			if(!$entity->getEffects()->add($instance)){
+				$gaps[] = "effect " . $id . " was not accepted";
+			}
+		}
+
+		return $gaps;
+	}
+
+	/**
+	 * @return array{0:int,1:int,2:int,3:bool,4:bool}
+	 */
+	private static function row(int $id, EffectInstance $instance) : array{
+		return [
+			$id,
+			$instance->isInfinite() ? self::INFINITE_DURATION : $instance->getDuration(),
+			$instance->getAmplifier(),
+			$instance->isVisible(),
+			$instance->isAmbient(),
+		];
+	}
+
+	private static function idOf(EffectInstance $instance) : ?int{
+		try{
+			return EffectIdMap::getInstance()->toId($instance->getType());
+		}catch(\InvalidArgumentException){
+			//A custom effect: this build cannot name it, so it must not travel.
+			return null;
+		}
+	}
+}
diff --git a/src/mukkit/BridgeEntityMirror.php b/src/mukkit/BridgeEntityMirror.php
new file mode 100644
index 000000000..c58880875
--- /dev/null
+++ b/src/mukkit/BridgeEntityMirror.php
@@ -0,0 +1,334 @@
+<?php
+
+declare(strict_types=1);
+
+namespace pocketmine\mukkit;
+
+use pocketmine\entity\Entity;
+use pocketmine\entity\EntityFactory;
+use pocketmine\entity\Living;
+use pocketmine\entity\object\ItemEntity;
+use pocketmine\nbt\tag\CompoundTag;
+use pocketmine\nbt\tag\DoubleTag;
+use pocketmine\nbt\tag\FloatTag;
+use pocketmine\nbt\tag\ListTag;
+use pocketmine\nbt\NBT;
+use pocketmine\world\World;
+
+/**
+ * A read-mostly mirror of the entities Nukkit has in the chunks the host mirrors.
+ *
+ * Why entities are harder than blocks: a plugin does not get a "block object", it gets a real
+ * `Entity` with a class, health, a world and an identity. Faking that with an array or a generic
+ * stand-in would break every `instanceof Zombie` in every plugin, so the mirror builds **real
+ * entities through PocketMine's own `EntityFactory`** - the same path a world uses when it loads
+ * entities from disk. Unknown types are reported and skipped, never approximated.
+ *
+ * The contract is deliberately asymmetric:
+ *
+ * - **Nukkit owns movement.** Each sync replaces positions, rotations and health. The entity is
+ *   moved with `applyMirroredTransform()`, not `teleport()`, so a wandering mob does not fire an
+ *   `EntityTeleportEvent` once a second for every plugin to see.
+ * - **Plugins own changes they make.** Position and health are diffed against a shadow and sent
+ *   back as `entity.state`; a plugin that teleports or damages a mirrored entity gets what it
+ *   asked for, and the next sync brings Nukkit's answer.
+ *
+ * Not mirrored on purpose: inventory/equipment, AI, damage events, and entities a plugin spawns
+ * (`World::addEntity()` still works, but the entity is local to PocketMine - Nukkit never hears
+ * about it). Dropped items are also out for now: `ItemEntity` needs an `Item` tag this frame does
+ * not carry, so they are reported as unsupported rather than spawned as empty stacks.
+ */
+final class BridgeEntityMirror{
+
+	/** @var array<string, array<int, Entity>> world folder name => Nukkit entity id => entity */
+	private array $entities = [];
+
+	/** @var array<string, array<int, array<string, float>>> world => id => last observed state */
+	private array $shadow = [];
+
+	/**
+	 * Applies a full entity snapshot for one world.
+	 *
+	 * A full list rather than add/update/remove deltas on purpose: the snapshot is small (the
+	 * chunks around the players), and a full list is self-healing - an entity the host refused
+	 * to create is attempted again next second instead of being lost until it happens to move.
+	 *
+	 * @param list<array<int, mixed>> $rows
+	 *
+	 * @return list<string> reasons an entity could not be represented
+	 */
+	public function sync(string $worldName, World $world, array $rows) : array{
+		$gaps = [];
+		$seen = [];
+
+		foreach($rows as $row){
+			if(!is_array($row) || count($row) < 7){
+				$gaps[] = "malformed entity row";
+				continue;
+			}
+			$id = (int) $row[0];
+			$type = (string) $row[1];
+			$x = (float) $row[2];
+			$y = (float) $row[3];
+			$z = (float) $row[4];
+			$yaw = (float) $row[5];
+			$pitch = (float) $row[6];
+			$health = isset($row[7]) ? (float) $row[7] : null;
+
+			$seen[$id] = true;
+			$entity = $this->entities[$worldName][$id] ?? null;
+
+			// Seventh item: a small map, because what an entity carries depends on what it is.
+			// `hp` for anything living, `item` for a dropped stack (the inventory dialect),
+			// `name` for a custom name tag and `effects` for potion effects. An arrow or a TNT
+			// block may carry nothing at all.
+			$extra = isset($row[7]) && is_array($row[7]) ? $row[7] : [];
+			$health = isset($extra["hp"]) ? (float) $extra["hp"] : null;
+			$itemTuple = isset($extra["item"]) && is_array($extra["item"]) ? $extra["item"] : null;
+			$name = isset($extra["name"]) ? (string) $extra["name"] : "";
+			$effects = isset($extra["effects"]) && is_array($extra["effects"]) ? $extra["effects"] : [];
+
+			if($entity === null || $entity->isClosed()){
+				unset($this->entities[$worldName][$id], $this->shadow[$worldName][$id]);
+				$reason = null;
+				$entity = $this->create($world, $type, $x, $y, $z, $yaw, $pitch, $itemTuple, $reason);
+				if($entity === null){
+					$gaps[] = $reason ?? ("unsupported entity type " . $type);
+					continue;
+				}
+				//`Entity::__construct()` already registers itself with the world; calling
+				//`World::addEntity()` again is an "already been added" exception.
+				$this->entities[$worldName][$id] = $entity;
+			}else{
+				// Nukkit is the authority on where this entity is; do not fire teleport events for
+				// the mirror catching up, they are not plugin actions. Skip the write entirely
+				// when nothing moved - `setPosition()` recalculates the bounding box and touches
+				// the world's chunk index, and most mobs stand still most seconds.
+				$location = $entity->getLocation();
+				if(abs($location->x - $x) > self::POSITION_EPSILON
+					|| abs($location->y - $y) > self::POSITION_EPSILON
+					|| abs($location->z - $z) > self::POSITION_EPSILON
+					|| abs($location->yaw - $yaw) > self::ROTATION_EPSILON
+					|| abs($location->pitch - $pitch) > self::ROTATION_EPSILON){
+					$entity->applyMirroredTransform(new \pocketmine\math\Vector3($x, $y, $z), $yaw, $pitch);
+				}
+			}
+
+			//The snapshot is complete, so an absent `name` means "no custom name", not "leave the
+			//old one": a name cleared on Nukkit's side has to be cleared here too.
+			if($entity->getNameTag() !== $name){
+				$entity->setNameTag($name);
+			}
+
+			if($health !== null && $entity instanceof Living && abs($entity->getHealth() - $health) > self::HEALTH_EPSILON){
+				$entity->setHealth(max(0.0, $health));
+			}
+
+			//Same rule for effects: the list is the complete set. Applying it also removes what
+			//Nukkit no longer has, which is how an expiring potion disappears from the mirror.
+			if($entity instanceof Living){
+				foreach(BridgeEffects::apply($entity, $effects) as $gap){
+					$gaps[] = "entity " . $id . ": " . $gap;
+				}
+			}
+		}
+
+		foreach($this->entities[$worldName] ?? [] as $id => $entity){
+			if(isset($seen[$id])){
+				continue;
+			}
+			// Gone from Nukkit's view (died, despawned, or the chunk stopped being mirrored).
+			$entity->close();
+			unset($this->entities[$worldName][$id], $this->shadow[$worldName][$id]);
+		}
+
+		// The sync is the baseline: anything a plugin changed before this point has been
+		// overwritten by Nukkit's value, and must not be reported as a fresh change.
+		foreach($this->entities[$worldName] ?? [] as $id => $entity){
+			$this->shadow[$worldName][$id] = self::snapshot($entity);
+		}
+
+		return $gaps;
+	}
+
+	/**
+	 * Reports what a plugin changed since the last sync.
+	 *
+	 * @return list<array<int, mixed>>
+	 */
+	public function diff(string $worldName) : array{
+		$changed = [];
+		foreach($this->entities[$worldName] ?? [] as $id => $entity){
+			if($entity->isClosed()){
+				continue;
+			}
+			$after = self::snapshot($entity);
+			$before = $this->shadow[$worldName][$id] ?? null;
+			$this->shadow[$worldName][$id] = $after;
+			if($before === null){
+				continue;
+			}
+
+			$extras = [];
+			if(!self::sameHealth($before, $after)){
+				$extras["hp"] = $after["health"] ?? 0.0;
+			}
+			if(!self::sameName($before, $after)){
+				//Always present when it changed, including "", so clearing a name travels.
+				$extras["name"] = $after["name"];
+			}
+			if(!self::sameEffects($before, $after)){
+				$extras["effects"] = $after["effects"];
+			}
+			if(!self::moved($before, $after) && $extras === []){
+				continue;
+			}
+
+			$tuple = [
+				$id,
+				$after["x"],
+				$after["y"],
+				$after["z"],
+				$after["yaw"],
+				$after["pitch"],
+			];
+			// Health only rides along when it is the thing that changed, so a moving mob does not
+			// keep re-asserting a health value Nukkit already knows. Extras are a map because a
+			// dropped stack uses the same slot for its item.
+			if($extras !== []){
+				$tuple[] = $extras;
+			}
+			$changed[] = $tuple;
+		}
+		return $changed;
+	}
+
+	public function forgetWorld(string $worldName) : void{
+		foreach($this->entities[$worldName] ?? [] as $entity){
+			if(!$entity->isClosed()){
+				$entity->close();
+			}
+		}
+		unset($this->entities[$worldName], $this->shadow[$worldName]);
+	}
+
+	public function forgetAll() : void{
+		foreach(array_keys($this->entities) as $worldName){
+			$this->forgetWorld($worldName);
+		}
+	}
+
+	public function count(string $worldName) : int{
+		return count($this->entities[$worldName] ?? []);
+	}
+
+	// ---------------------------------------------------------------- pure helpers
+
+	private const POSITION_EPSILON = 0.001;
+	private const ROTATION_EPSILON = 0.05;
+	private const HEALTH_EPSILON = 0.001;
+
+	/**
+	 * @param array<string, mixed> $before
+	 * @param array<string, mixed> $after
+	 */
+	private static function moved(array $before, array $after) : bool{
+		return abs($before["x"] - $after["x"]) > self::POSITION_EPSILON
+			|| abs($before["y"] - $after["y"]) > self::POSITION_EPSILON
+			|| abs($before["z"] - $after["z"]) > self::POSITION_EPSILON
+			|| abs($before["yaw"] - $after["yaw"]) > self::ROTATION_EPSILON
+			|| abs($before["pitch"] - $after["pitch"]) > self::ROTATION_EPSILON;
+	}
+
+	/**
+	 * @param array<string, mixed> $before
+	 * @param array<string, mixed> $after
+	 */
+	private static function sameHealth(array $before, array $after) : bool{
+		if(!isset($before["health"]) || !isset($after["health"])){
+			return isset($before["health"]) === isset($after["health"]);
+		}
+		return abs($before["health"] - $after["health"]) <= self::HEALTH_EPSILON;
+	}
+
+	/**
+	 * @param array<string, mixed> $before
+	 * @param array<string, mixed> $after
+	 */
+	private static function sameName(array $before, array $after) : bool{
+		return ($before["name"] ?? "") === ($after["name"] ?? "");
+	}
+
+	/**
+	 * Effect lists are ordered by id and carry plain scalars, so a strict comparison is enough.
+	 * PocketMine does not tick the mirror world, so durations do not drift by themselves here.
+	 *
+	 * @param array<string, mixed> $before
+	 * @param array<string, mixed> $after
+	 */
+	private static function sameEffects(array $before, array $after) : bool{
+		return ($before["effects"] ?? []) === ($after["effects"] ?? []);
+	}
+
+	/**
+	 * @return array<string, mixed>
+	 */
+	private static function snapshot(Entity $entity) : array{
+		$location = $entity->getLocation();
+		$snapshot = [
+			"x" => $location->x,
+			"y" => $location->y,
+			"z" => $location->z,
+			"yaw" => $location->yaw,
+			"pitch" => $location->pitch,
+			"name" => $entity->getNameTag(),
+			"effects" => [],
+		];
+		if($entity instanceof Living){
+			$snapshot["health"] = $entity->getHealth();
+			$snapshot["effects"] = BridgeEffects::snapshot($entity->getEffects());
+		}
+		return $snapshot;
+	}
+
+	private function create(World $world, string $type, float $x, float $y, float $z, float $yaw, float $pitch, ?array $itemTuple, ?string &$reason) : ?Entity{
+		$nbt = new CompoundTag();
+		$nbt->setString(EntityFactory::TAG_IDENTIFIER, $type);
+		// The shape `EntityDataHelper::parseLocation()` expects when a world loads actors from
+		// disk; using it means the factory's own constructors do the type-specific work.
+		$nbt->setTag(Entity::TAG_POS, new ListTag(
+			[new DoubleTag($x), new DoubleTag($y), new DoubleTag($z)],
+			NBT::TAG_Double
+		));
+		$nbt->setTag(Entity::TAG_ROTATION, new ListTag(
+			[new FloatTag($yaw), new FloatTag($pitch)],
+			NBT::TAG_Float
+		));
+
+		if($itemTuple !== null){
+			// A dropped stack is the inventory dialect one level down: same id/count/damage/NBT,
+			// translated by the same function, then handed to `ItemEntity` in the exact NBT shape
+			// the factory's `Item::nbtDeserialize()` reads.
+			[$item, $itemReason] = BridgePlayerInventory::parseItem(
+				(string) ($itemTuple[0] ?? ""),
+				(int) ($itemTuple[1] ?? 0),
+				(int) ($itemTuple[2] ?? 0),
+				isset($itemTuple[3]) && is_string($itemTuple[3]) ? $itemTuple[3] : null
+			);
+			if($item === null || $item->isNull()){
+				$reason = "dropped item: " . ($itemReason ?? "item is air");
+				return null;
+			}
+			$nbt->setTag(ItemEntity::TAG_ITEM, $item->nbtSerialize());
+		}
+
+		try{
+			return EntityFactory::getInstance()->createFromData($world, $nbt);
+		}catch(\Throwable $e){
+			// An entity whose save data this build does not understand: report it as a gap, do
+			// not invent a stand-in.
+			$reason = "could not build " . $type . ": " . $e->getMessage();
+			return null;
+		}
+	}
+}
