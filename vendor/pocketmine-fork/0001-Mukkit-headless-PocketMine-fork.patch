index 000000000..07e3e4e23
--- /dev/null
+++ b/src/mukkit/polyfill/thread.php
@@ -0,0 +1,226 @@
+<?php
+
+/*
+ * Mukkit: single-threaded shims for pmmp/ext-threads.
+ *
+ * Upstream PocketMine requires the pmmpthread C extension. A headless host never starts a worker
+ * thread - the only thing it needs from that extension is that classes such as ThreadSafe and
+ * ThreadSafeArray *exist*, because PM's own src/thread/* hierarchy extends them at load time.
+ *
+ * These shims are therefore plain PHP with no locking. They are correct only because everything
+ * runs on one thread; if the fork ever starts a real thread, this file must be deleted, not
+ * "fixed". Load before any PocketMine class (see src/mukkit/polyfill.php).
+ */
+
+declare(strict_types=1);
+
+namespace pmmp\thread {
+
+	/**
+	 * Base class for shared structures. In the extension this is what lets properties survive
+	 * thread boundaries; here it is a marker class only.
+	 */
+	#[\AllowDynamicProperties]
+	class ThreadSafe{
+
+		/**
+		 * Runs the closure while "holding the lock". Without threads there is nothing to exclude,
+		 * so the call is inlined - the contract (atomic section) is trivially satisfied.
+		 */
+		public function synchronized(\Closure $block, mixed ...$args) : mixed{
+			return $block(...$args);
+		}
+
+		public function wait(int $timeout = 0) : bool{
+			return true;
+		}
+
+		public function notify() : void{
+		}
+
+		public function notifyAll() : void{
+		}
+	}
+
+	/**
+	 * Array-like shared map.
+	 *
+	 * Items are stored as dynamic properties instead of a backing array on purpose: upstream code
+	 * casts this object to array in a few places (e.g. AttachableThreadSafeLogger::getAttachments()),
+	 * and a backing array would make that cast return `['items' => [...]]` instead of the items.
+	 */
+	#[\AllowDynamicProperties]
+	class ThreadSafeArray extends ThreadSafe implements \ArrayAccess, \Countable, \IteratorAggregate{
+
+		public function offsetExists(mixed $offset) : bool{
+			return isset($this->{(string) $offset});
+		}
+
+		public function offsetGet(mixed $offset) : mixed{
+			return $this->{(string) $offset} ?? null;
+		}
+
+		public function offsetSet(mixed $offset, mixed $value) : void{
+			if($offset === null){
+				//$arr[] = $value: the extension picks the next integer key, same as a PHP array.
+				$next = 0;
+				foreach(get_object_vars($this) as $key => $_){
+					if(is_int($key) && $key >= $next){
+						$next = $key + 1;
+					}
+				}
+				$this->{$next} = $value;
+				return;
+			}
+			$this->{(string) $offset} = $value;
+		}
+
+		public function offsetUnset(mixed $offset) : void{
+			unset($this->{(string) $offset});
+		}
+
+		public function count() : int{
+			return count(get_object_vars($this));
+		}
+
+		public function getIterator() : \Iterator{
+			return new \ArrayIterator(get_object_vars($this));
+		}
+	}
+
+	/**
+	 * Unit of work. The extension class carries synchronisation state; the shim only carries the
+	 * contract, so AsyncTask and friends can still be declared.
+	 */
+	abstract class Runnable extends ThreadSafe{
+		abstract public function run() : void;
+	}
+
+	/**
+	 * Thread handle. start() deliberately does not execute run(): the headless host has no thread
+	 * pool, and running a worker's run() inline would block the tick loop forever.
+	 */
+	class Thread extends Runnable{
+		public const INHERIT_NONE = 0;
+		public const INHERIT_INI = 1;
+		public const INHERIT_COMMENTS = 2;
+
+		private bool $running = false;
+		private bool $joined = false;
+		private string $name = "";
+
+		public function run() : void{
+		}
+
+		/**
+		 * Signature has to match pmmp/ext-threads exactly: PocketMine's
+		 * `CommonThreadPartsTrait::start(int $options = NativeThread::INHERIT_NONE): bool` is
+		 * compiled against it, and a nullable default is a fatal declaration error the moment any
+		 * plugin causes that trait to load (BedcoreProtect's libasynql was the first to).
+		 */
+		public function start(int $options = self::INHERIT_NONE) : bool{
+			$this->running = true;
+			return true;
+		}
+
+		public function join() : bool{
+			$this->joined = true;
+			$this->running = false;
+			return true;
+		}
+
+		public function isRunning() : bool{
+			return $this->running;
+		}
+
+		public function isJoined() : bool{
+			return $this->joined;
+		}
+
+		public function quit() : void{
+			$this->running = false;
+		}
+
+		public function getThreadName() : string{
+			return $this->name;
+		}
+
+		public function setThreadName(string $name) : void{
+			$this->name = $name;
+		}
+
+		public function getThreadId() : int{
+			return 0;
+		}
+	}
+
+	/**
+	 * Worker thread. Stack operations are kept in a local array so AsyncPool can be constructed
+	 * without touching a missing extension; nothing is ever actually executed here.
+	 */
+	class Worker extends Thread{
+		/** @var list<Runnable> */
+		private array $stack = [];
+		private bool $shutdown = false;
+
+		public function stack(Runnable $runnable) : int{
+			$this->stack[] = $runnable;
+			return count($this->stack) - 1;
+		}
+
+		public function unstack() : ?Runnable{
+			return array_pop($this->stack);
+		}
+
+		/** @return list<Runnable> */
+		public function getStacked() : array{
+			return $this->stack;
+		}
+
+		public function isShutdown() : bool{
+			return $this->shutdown;
+		}
+
+		public function shutdown() : void{
+			$this->shutdown = true;
+			$this->stack = [];
+		}
+	}
+
+	/**
+	 * Pool of workers. Present so `Thread as NativeThread` aliases and Pool subclasses resolve.
+	 */
+	class Pool extends ThreadSafe{
+		/** @var array<int, Worker> */
+		private array $workers = [];
+		private int $size = 0;
+
+		public function __construct(int $size, string $class = Worker::class, ?int $ctor = null){
+			$this->size = $size;
+		}
+
+		public function getSize() : int{
+			return $this->size;
+		}
+
+		public function getWorkerCount() : int{
+			return count($this->workers);
+		}
+
+		public function getWorker(int $workerId) : ?Worker{
+			return $this->workers[$workerId] ?? null;
+		}
+
+		public function startWorker() : bool{
+			return false;
+		}
+
+		public function shutdown() : void{
+			$this->workers = [];
+		}
+
+		public function collect(?callable $collector = null) : int{
+			return 0;
+		}
+	}
+}
diff --git a/src/mukkit/polyfill/yaml.php b/src/mukkit/polyfill/yaml.php
new file mode 100644
index 000000000..737a78123
--- /dev/null
+++ b/src/mukkit/polyfill/yaml.php
@@ -0,0 +1,63 @@
+<?php
+
+/*
+ * Mukkit: global-function shims for ext-yaml.
+ *
+ * PocketMine calls the plain functions `yaml_parse()` / `yaml_emit()` behind `use function`
+ * imports, so defining them conditionally here keeps every upstream call site untouched - no fork
+ * patch in Config.php, PluginDescription.php or Server.php. If the real extension is present it
+ * wins, and this file becomes a no-op.
+ */
+
+declare(strict_types=1);
+
+use pocketmine\mukkit\Yaml;
+
+if(!defined("YAML_ANY_ENCODING")){
+	define("YAML_ANY_ENCODING", 0);
+	define("YAML_UTF8_ENCODING", 1);
+	define("YAML_ANY_BREAK", 0);
+	define("YAML_CR_BREAK", 1);
+	define("YAML_LN_BREAK", 2);
+	define("YAML_CRLN_BREAK", 3);
+}
+
+if(!function_exists("yaml_parse")){
+	/**
+	 * @param int $pos unused; PM always parses the whole document
+	 * @param int|null $ndocs set to 1 so callers that check document count behave
+	 * @param array|null $callbacks unused
+	 */
+	function yaml_parse(string $input, int $pos = 0, ?int &$ndocs = null, ?array $callbacks = null) : mixed{
+		$ndocs = 1;
+		return Yaml::parse($input);
+	}
+}
+
+if(!function_exists("yaml_emit")){
+	function yaml_emit(mixed $data, int $encoding = YAML_ANY_ENCODING, int $linebreak = YAML_ANY_BREAK, ?array $callbacks = null) : string{
+		return Yaml::emit($data);
+	}
+}
+
+//Plugins load their own YAML files (language packs, configs) and do not always go through
+//`Config`: MultiWorld's LanguageManager calls `yaml_parse_file()` directly, and on stock PHP the
+//missing function killed the whole host at onEnable. The file variants are thin wrappers, not a
+//second parser.
+if(!function_exists("yaml_parse_file")){
+	function yaml_parse_file(string $filename, int $pos = 0, ?int &$ndocs = null, ?array $callbacks = null) : mixed{
+		$content = @file_get_contents($filename);
+		if($content === false){
+			$ndocs = 0;
+			return false;
+		}
+		$ndocs = 1;
+		return Yaml::parse($content);
+	}
+}
+
+if(!function_exists("yaml_emit_file")){
+	function yaml_emit_file(string $filename, mixed $data, int $encoding = YAML_ANY_ENCODING, int $linebreak = YAML_ANY_BREAK, ?array $callbacks = null) : bool{
+		return file_put_contents($filename, Yaml::emit($data)) !== false;
+	}
+}
